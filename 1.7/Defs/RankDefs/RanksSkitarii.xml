    <Core40k.RankDef>
        <defName>Seg_COTO_SkitariiMarshal</defName>
        <label>Skitarii Marshal</label>
        <description>A Marshal is a leader of Skitarii cohorts, an experienced veteran of numerous battles and campaigns. They act as intermediates between the ordained techpriests and the ranks of the Skitarii Legions.</description>
        <rankIconPath>UI/Ranks/Skitarii/Seg_COTO_RankSkitarii_SkitariiMarshal</rankIconPath>
        <rankTier>6</rankTier>
        <colonyLimitOfRank>(1, 0)</colonyLimitOfRank>
        <requirements>
            <li Class="Core40k.PawnRequirement_Skills">
                <skills>
					<Social>6</Social>
                </skills>
            </li>
			<li Class="Core40k.PawnRequirement_Hediffs">
				<hediffs>
					<li>Seg_COTO_SkitariiDataUplink_Hediff</li>
				</hediffs>
				<oneAmong>true</oneAmong>
			</li>
			<li Class="Seg.PawnRequirement_ArtificialParts">
				<count>8</count>
			</li>
        </requirements>
        <givesPassions>
            <li>
				<skill>Social</skill>
