    <ThingDef ParentName="FF_FireBase">
    <defName>PhosphorFire</defName>
    <label>phosphor fire</label>
    <thingClass>Seg.PhosphorFire</thingClass>

    <graphicData>
        <graphicClass>Graphic_Flicker</graphicClass>
        <texPath>Things/Special/PhosphorFire</texPath>
        <shaderType>TransparentPostLight</shaderType>
        <drawSize>1.5</drawSize>
    </graphicData>


    <comps>
        <li Class="CompProperties_Glower">
            <glowRadius>4.0</glowRadius>
            <glowColor>(255,255,255)</glowColor>
        </li>
    </comps>
    <modExtensions>
      <li Class="FireFlamework.FireDefExtension">
        <SmokeFleckDef>Smoke</SmokeFleckDef>
        <MicroSparksFleckDef>PhosphorMicroSparks</MicroSparksFleckDef>
        <FireGlowFleckDef>PhosphorFireGlow</FireGlowFleckDef>
        <extinguishDamageDef>PhosphorExtinguish</extinguishDamageDef>
        <FireIconPath>Things/Special/PhosphorFire/PhosphorFire</FireIconPath>
        <FireAdjective>Phosphor</FireAdjective>
        <CanBePutOutNormally>true</CanBePutOutNormally> <!-- we should make a way to put it out with a special extinguisher, then ill set this to false.-->
      </li>
    </modExtensions>
</ThingDef>


</Defs>
