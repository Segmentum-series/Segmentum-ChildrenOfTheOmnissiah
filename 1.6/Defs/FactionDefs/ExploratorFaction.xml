<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <FactionDef ParentName="FactionBase">
        <defName>Seg_COTO_HostileMechanicus</defName>
        <label>Mechanicus Explorators</label>
        <description>A company of the Emperor's finest warriors, the Adeptus Astartes, charged with purging heresy from this backwater rimworld.</description>

        <pawnSingular>explorator</pawnSingular>
        <pawnsPlural>explorators</pawnsPlural>
        <!--fixedLeaderKinds>
            <li>BEWH_LordCommanderPawn</li>
        </fixedLeaderKinds-->
        <leaderTitle>Explorator Majoris</leaderTitle>

        <settlementGenerationWeight>1</settlementGenerationWeight>
        <requiredCountAtGameStart>1</requiredCountAtGameStart>
        <allowedArrivalTemperatureRange>-100~200</allowedArrivalTemperatureRange>
        <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
        <configurationListOrderPriority>90</configurationListOrderPriority>

        <canSiege>true</canSiege>
        <canStageAttacks>true</canStageAttacks>
        <permanentEnemy>true</permanentEnemy>
        <techLevel>Ultra</techLevel>
        <rescueesCanJoin>false</rescueesCanJoin>

        <factionNameMaker>NamerFactionMechanicusHostile</factionNameMaker>
        <settlementNameMaker>Seg_COTO_NamerSettlementMechanicus</settlementNameMaker>
        <factionIconPath>UI/Icons/Imperium/Seg_COTO_MechanicusOutpost</factionIconPath>
        <settlementTexturePath>UI/Icons/Imperium/Seg_COTO_MechanicusOutpost</settlementTexturePath>

        <xenotypeSet Inherit="False">
            <xenotypeChances>
                <Baseliner>1</Baseliner>
            </xenotypeChances>
        </xenotypeSet>
        <backstoryFilters>
            <li>
                <categoriesChildhood>
                    <li>SegCOTO_Mechanicus</li>
                </categoriesChildhood>
                <categoriesAdulthood>
                    <li>SegCOTO_Mechanicus</li>
                    <li>SegCOTO_Techpriest</li>
                </categoriesAdulthood>
            </li>
        </backstoryFilters>


        <allowedCultures MayRequire="Ludeon.RimWorld.Ideology">
            <li>Seg_COTO_Mechanicus</li>
        </allowedCultures>

        <fixedIdeo MayRequire="Ludeon.RimWorld.Ideology">true</fixedIdeo>
        <ideoName MayRequire="Ludeon.RimWorld.Ideology">Machine Cult</ideoName>
        <ideoDescription MayRequire="Ludeon.RimWorld.Ideology">The Machine Cult, or Cult Mechanicus, is the state religion of the Adeptus Mechanicus of Mars and its various forge worlds. Ruled by tech-priests who obsess over ancient knowledge and technology, the cult venerates a triune godhead in the form of the Machine God, the Motive Force, and the Omnissiah. The Emperor of Mankind is officially regarded as the physical incarnation of the Omnissiah in the material world.</ideoDescription>
        <deityPresets MayRequire="Ludeon.RimWorld.Ideology">
            <li>
                <nameType>
                    <name>The Machine God</name>
                    <type>Three-in-One</type>
                </nameType>
                <gender>None</gender>
                <iconPath>UI/Deities/DeityGeneric</iconPath>
            </li>
        </deityPresets>
        <styles>
            <li MayRequire="Ludeon.RimWorld.Ideology">Techist</li>
        </styles>
        <forcedMemes>
            <li MayRequire="Ludeon.RimWorld.Ideology">Structure_TheistAbstract</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">MachineImmortal</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">TechnoAnimism</li>
        </forcedMemes>
        <requiredPreceptsOnly MayRequire="Ludeon.RimWorld.Ideology">false</requiredPreceptsOnly>


        <earliestRaidDays>45</earliestRaidDays>
        <autoFlee>false</autoFlee>
        <raidCommonalityFromPointsCurve>
            <points>
                <li>(0, 1)</li>
            </points>
        </raidCommonalityFromPointsCurve>
        <maxPawnCostPerTotalPointsCurve>
            <points>
                <li>(0,0)</li>
                <li>(400, 100)</li>
                <li>(1000, 200)</li>
                <li>(2000, 400)</li>
                <li>(5000, 1000)</li>
                <li>(10000, 3000)</li>
                <li>(100000, 10000)</li>
            </points>
        </maxPawnCostPerTotalPointsCurve>
        <pawnGroupMakers>
            <!-- Skitarii Patrol -->
            <li>
                <kindDef>Combat</kindDef>
                <commonality>100</commonality>
                <options>
                    <Seg_COTO_SkitariiVanguard>15</Seg_COTO_SkitariiVanguard>
                    <Seg_COTO_SkitariiRanger>10</Seg_COTO_SkitariiRanger>
                    <!--Seg_COTO_SicarianRuststalker>8</Seg_COTO_SicarianRuststalker>
                    <Seg_COTO_SicarianInfiltrator>8</Seg_COTO_SicarianInfiltrator-->
                </options>
            </li>
            <!-- Skitarii/myrmidon force -->
            <li>
                <kindDef>Combat</kindDef>
                <commonality>30</commonality>
                <options>
                    <Seg_COTO_SkitariiVanguard>15</Seg_COTO_SkitariiVanguard>
                    <Seg_COTO_SkitariiRanger>10</Seg_COTO_SkitariiRanger>
                    <!--Seg_COTO_SicarianRuststalker>8</Seg_COTO_SicarianRuststalker>
                    <Seg_COTO_SicarianInfiltrator>8</Seg_COTO_SicarianInfiltrator-->
                    <Seg_COTO_Myrmidon>5</Seg_COTO_Myrmidon>
                </options>
            </li>
            <!-- Myrmidon squad -->
            <li>
                <kindDef>Combat</kindDef>
                <commonality>20</commonality>
                <options>
                    <Seg_COTO_Myrmidon>5</Seg_COTO_Myrmidon>
                    <!--Seg_COTO_SicarianRuststalker>10</Seg_COTO_SicarianRuststalker>
                    <Seg_COTO_SicarianInfiltrator>10</Seg_COTO_SicarianInfiltrator-->
                </options>
            </li>
            <!-- Base defence -->
            <li>
                <kindDef>Settlement</kindDef>
                <options>
                    <Seg_COTO_SkitariiVanguard>15</Seg_COTO_SkitariiVanguard>
                    <Seg_COTO_SkitariiRanger>10</Seg_COTO_SkitariiRanger>
                    <!--Seg_COTO_SicarianRuststalker>8</Seg_COTO_SicarianRuststalker>
                    <Seg_COTO_SicarianInfiltrator>8</Seg_COTO_SicarianInfiltrator>
                    <Seg_COTO_Myrmidon>5</Seg_COTO_Myrmidon-->
                </options>
            </li>
        </pawnGroupMakers>
        <disallowedRaidAgeRestrictions>
            <li>Children</li>
        </disallowedRaidAgeRestrictions>
    </FactionDef>

</Defs>