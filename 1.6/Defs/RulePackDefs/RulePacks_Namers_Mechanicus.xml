  <RulePackDef>
    <defName>LeaderTitleMaker_Omnissian</defName>
    <rulePack>
      <rulesStrings>
        <li>r_leaderTitle->Prime Hermeticon</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>
 
  <RulePackDef>
    <defName>MoralGuideTitleMaker_Omnissian</defName>
    <rulePack>
      <rulesStrings>
        <li>r_moralguideTitle->Missionarius</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

  <RulePackDef>
    <defName>Seg_COTO_NamerTraderMechanicus</defName>
    <rulePack>
      <rulesStrings>
        <li>r_name->[MechanicusShipHolyName]'s [MechanicusShipNoun]</li>
        <li>r_name->[MechanicusShipAdjective] [MechanicusShipNoun]</li>
        <li>r_name->[MechanicusShipAdjective] [MechanicusShipNoun] [MechanicusShipNumeral]</li>
        <li>r_name->[MechanicusShipAdjective] [MechanicusShipNoun] of [MechanicusShipFamousPlace]</li>
        <li>r_name->[MechanicusShipAdjective] [MechanicusShipFamousPlace]</li>
        <li>r_name->[MechanicusShipNoun] of the [MechanicusShipHolyName]</li>
        <li>r_name->[MechanicusShipNoun] of [MechanicusShipFamousPlace]</li>
        <li>r_name->[MechanicusShipNoun] of [MechanicusShipFamousPlace] [MechanicusShipNumeral]</li>
        <li>r_name->[MechanicusShipFamousPlace] [MechanicusShipCode][MechanicusShipNumeral]</li>
        <li>r_name->[MechanicusShipFamousPlaceAdjective] [MechanicusShipNoun]</li>
        <li>r_name->[MechanicusShipFamousPlace]'s [MechanicusShipNoun]</li>
        <li>r_name->[MechanicusShipFamousPlace] [MechanicusShipNumeral]</li>
        <li>r_name->[MechanicusShipCode] [MechanicusShipNoun] of [MechanicusShipFamousPlace]</li>
      </rulesStrings>
      <rulesFiles>
        <li>MechanicusShipHolyName->SegmentumChildrenOfTheOmnissiahNames/Names/MechanicusShipHolyName</li>
        <li>MechanicusShipNoun->SegmentumChildrenOfTheOmnissiahNames/Names/MechanicusShipNoun</li>
        <li>MechanicusShipFamousPlace->SegmentumChildrenOfTheOmnissiahNames/Names/MechanicusShipFamousPlace</li>
        <li>MechanicusShipCode->SegmentumChildrenOfTheOmnissiahNames/Names/MechanicusShipCode</li>
        <li>MechanicusShipNumeral->SegmentumChildrenOfTheOmnissiahNames/Names/MechanicusShipNumeral</li>
        <li>MechanicusShipFamousPlaceAdjective->SegmentumChildrenOfTheOmnissiahNames/Names/MechanicusShipFamousPlaceAdjective</li>
        <li>MechanicusShipAdjective->SegmentumChildrenOfTheOmnissiahNames/Names/MechanicusShipAdjective</li>
      </rulesFiles>
    </rulePack>
  </RulePackDef>
 
</Defs>
