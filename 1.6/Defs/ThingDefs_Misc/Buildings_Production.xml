		</comps>
		<graphicData>
			<texPath>Things/Building/AugmentsTable/Seg_COTO_AugmentsTable</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(3.5,3.5)</drawSize>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
