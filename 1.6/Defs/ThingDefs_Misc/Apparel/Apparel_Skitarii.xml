	<!-- Skitarii bodysuit -->
	<ThingDef ParentName="Seg_COTO_SkitariiBase">
		<defName>Seg_COTO_Apparel_SkitariiFatigues</defName>
		<label>skitarii bodysuit</label>
		<description>A bodysuit utilized in the entire Skitarii range. It is designed to cover only the remaining flesh of the tech-guard's bodies, giving a degree of environmental protection while being adaptable to their ever decreasing biomass.\n\n&lt;color=#40cbde&gt;Customizable in the styling station or Mechanicus forge altar&lt;/color&gt;.</description>

		<graphicData>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>BEWH_CutoutThreeColor</shaderType>
			<texPath>Things/Apparel/SkitariiFatigues/Seg_COTO_SkitariiFatigues</texPath>
		</graphicData>

		<statBases>
			<WorkToMake>12000</WorkToMake>
			<MaxHitPoints>350</MaxHitPoints>
			<Mass>2.2</Mass>
			<ArmorRating_Sharp>0.35</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.05</ArmorRating_Blunt>
			<ArmorRating_Heat>0.40</ArmorRating_Heat>
			<Insulation_Cold>14.4</Insulation_Cold>
			<Insulation_Heat>20</Insulation_Heat>
		</statBases>
		<equippedStatOffsets>    
				<ToxicResistance>1.00</ToxicResistance>
				<ToxicEnvironmentResistance>1.0</ToxicEnvironmentResistance>

      			<DecompressionResistance MayRequire="kentington.saveourship2">0.14</DecompressionResistance>
      			<VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.14</VacuumResistance>
    	</equippedStatOffsets>
		<costList>
			<Hyperweave>30</Hyperweave>
			<Seg_Ceramite>10</Seg_Ceramite>
		</costList>

		<apparel>
			<useWornGraphicMask>true</useWornGraphicMask>
			<tags>
				<li>Seg_COTO_Robe</li>
				<li>Seg_COTO_Skitarii</li>
			</tags>
			<countsAsClothingForNudity>true</countsAsClothingForNudity>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Shoulders</li>
				<li>Neck</li>
				<li>Legs</li>
				<li>Arms</li>
			</bodyPartGroups>
			<layers>
				<li>OnSkin</li>
			</layers>
			<defaultOutfitTags>
				<li>Worker</li>
			</defaultOutfitTags>
			<wornGraphicPaths>
				<li>Things/Apparel/SkitariiFatigues/Seg_COTO_SkitariiFatigues</li>
			</wornGraphicPaths>
		</apparel>
		<comps>
			<li Class="Core40k.CompProperties_MultiColor" MayRequire="phonicmas.rimdark.frameworkcore">
				<defaultPrimaryColor>(80,94,104)</defaultPrimaryColor><!-- Bodysuit Grey Blue -->
				<defaultSecondaryColor>(166,166,166)</defaultSecondaryColor><!-- Grey -->
				<defaultTertiaryColor>(234,130,56)</defaultTertiaryColor><!-- Adamantium -->
				<!-- It has no extra decorations -->
			</li>
		</comps>
		<modExtensions>
		<li Class="Core40k.DefModExtension_AvailableDrawerTabDefs">
			<tabDefs>
				<li>BEWH_ArmorColoring</li>
				<li>BEWH_ArmorDecoration</li>
			</tabDefs>
		</li>
		</modExtensions>
	</ThingDef>

	<!-- Skitarii ranger hood -->
