	<!-- Marshal backpack -->
	<ThingDef ParentName="Seg_COTO_BackpackBase">
		<defName>Seg_COTO_Apparel_MarshalBackpack</defName>
		<label>Marshal backpack</label>
		<description>Marshals make use of particularly advanced command and control equipment, with noospheric data-tethers, servo-skull uplinks, and portable cogitators all carried into the field to maximize efficacy.\n\n&lt;color=#40cbde&gt;Customizable in the styling station or Mechanicus forge altar&lt;/color&gt;.\n\n&lt;color=#bb8f04&gt;Powerpack or power source, refueld with Uranium&lt;/color&gt;.</description> 
		<graphicData>
			<texPath>Things/Apparel/MarshalBackpack/Seg_COTO_MarshalBackpack</texPath>
		</graphicData>
		<recipeMaker>
			<researchPrerequisite>Seg_COTO_ManipleTactics</researchPrerequisite>
		</recipeMaker>
		<costList>
			<Plasteel>30</Plasteel>
			<ComponentIndustrial>5</ComponentIndustrial>
