<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- Backpack base -->
	<ThingDef Abstract="true" Name="Seg_COTO_BackpackBase" ParentName="ArmorMachineableBase">
		<techLevel>Spacer</techLevel>
		<recipeMaker>
			<unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
			<skillRequirements>
				<Crafting>8</Crafting>
			</skillRequirements>
			<recipeUsers Inherit="false">
				<li>Seg_COTO_CraftingTable</li>
			</recipeUsers>
		</recipeMaker>
		<thingCategories>
			<li>Seg_COTO_MechanicusArmor</li>
		</thingCategories>
		<tradeTags>
			<li>Seg_COTO_MechanicusArmor</li>
		</tradeTags>
		<graphicData>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>BEWH_CutoutThreeColor</shaderType>
		</graphicData>
		<apparel>
			<useWornGraphicMask>true</useWornGraphicMask>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Shoulders</li>
			</bodyPartGroups>
			<layers>
				<li>Backpack</li>
			</layers>
			<countsAsClothingForNudity>true</countsAsClothingForNudity>
		</apparel>
		<modExtensions>
			<li Class="VEF.Apparels.ApparelExtension">
				<isUnifiedApparel>true</isUnifiedApparel>
				<hideHead>false</hideHead>
			</li>
		</modExtensions>
	</ThingDef>

	<!-- Magos backpack -->
	<ThingDef ParentName="Seg_COTO_BackpackBase">
		<defName>Seg_COTO_Apparel_MagosBackpack</defName>
		<label>magos powerpack</label>
		<description>A standard modular powered backpack, designed to power and manipulate a multitude of tools required in the general operations of any Magos.\n\n&lt;color=#40cbde&gt;Customizable in the styling station or Mechanicus forge altar&lt;/color&gt;.</description>
		<!-- Removed for now to avoid confusion with powerpack mention, replace above once the system is back in place
		<description>A standard modular powered backpacks, designed to power and manipulate a multitude of tools required in the general operations of any Magos.\n\n&lt;color=#40cbde&gt;Customizable in the styling station or Mechanicus forge altar&lt;/color&gt;.\n\n&lt;color=#bb8f04&gt;Powerpack or power source&lt;/color&gt;.</description> -->
		<graphicData>
			<texPath>Things/Apparel/MagosBackpack/Seg_COTO_MagosBackpack</texPath>
			<drawSize>(1.20,1.20)</drawSize>
		</graphicData>
		<recipeMaker>
			<researchPrerequisite>Seg_COTO_CultMechanicus</researchPrerequisite>
		</recipeMaker>
		<costList>
			<Steel>40</Steel>
			<ComponentIndustrial>3</ComponentIndustrial>
			<Cloth>20</Cloth>
		</costList>
		<statBases>
			<WorkToMake>8000</WorkToMake>
			<MaxHitPoints>350</MaxHitPoints>
			<Mass>2.2</Mass>
			<ArmorRating_Sharp>0.30</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.20</ArmorRating_Blunt>
			<ArmorRating_Heat>0.01</ArmorRating_Heat> 
		</statBases>
		<equippedStatOffsets>
			<MoveSpeed>-0.15</MoveSpeed>
			<CarryingCapacity>20</CarryingCapacity>
			<VEF_MassCarryCapacity>20</VEF_MassCarryCapacity>
		</equippedStatOffsets>
		<apparel>
			<wornGraphicPath>Things/Apparel/MagosBackpack/Seg_COTO_MagosBackpack</wornGraphicPath>
			<drawData>
				<dataSouth>
					<layer>15</layer>
				</dataSouth>
				<dataWest>
					<layer>80</layer>
				</dataWest>
				<dataEast>
					<layer>80</layer>
				</dataEast>
				<dataNorth>
					<layer>100</layer>
				</dataNorth>
			</drawData>
			<defaultOutfitTags>
				<li>Worker</li>
			</defaultOutfitTags>
		</apparel>
		<comps>
			<li Class="Core40k.CompProperties_MultiColor" MayRequire="phonicmas.rimdark.frameworkcore">
				<defaultPrimaryColor>(234,130,56)</defaultPrimaryColor>
				<defaultSecondaryColor>(25,146,198)</defaultSecondaryColor>
			</li>
			<!-- Currently disabled to avoid conflicts with laser content + requires actual customziation, as this is the raw example provided by BlackMarket420
			<li Class="CompProperties_ApparelReloadable">
				<maxCharges>500</maxCharges>
				<ammoDef>Ammunition_Spacer</ammoDef>
				<ammoCountPerCharge>1</ammoCountPerCharge>
				<baseReloadTicks>60</baseReloadTicks>
				<soundReload>Standard_Reload</soundReload>
				<hotKey>Misc4</hotKey>
				<chargeNoun>smokepop</chargeNoun>
				<displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
				<displayGizmoWhileDrafted>true</displayGizmoWhileDrafted>
			</li> -->
		</comps>
		<modExtensions>
			<li Class="Core40k.DefModExtension_AvailableDrawerTabDefs">
				<tabDefs>
					<li>BEWH_ArmorColoring</li>
				</tabDefs>
			</li>
		</modExtensions>
	</ThingDef>

	<!-- Skitarii backpack -->
	<ThingDef ParentName="Seg_COTO_BackpackBase">
