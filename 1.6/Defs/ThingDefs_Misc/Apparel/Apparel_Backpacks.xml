		<modExtensions>
			<li Class="Core40k.DefModExtension_AvailableDrawerTabDefs">
				<tabDefs>
					<li>BEWH_ArmorColoring</li>
					<li>BEWH_ArmorDecoration</li>
				</tabDefs>
			</li>
		</modExtensions>
	</ThingDef>

	<!-- Marshal backpack -->
	<ThingDef ParentName="Seg_COTO_BackpackBase">
		<defName>Seg_COTO_Apparel_MarshalBackpack</defName>
		<label>Marshal backpack</label>
		<description>Skitarii Marshals make use of particularly advanced command and control equipment, with noospheric data-tethers, servo-skull uplinks, and portable cogitators all carried into the field to maximize efficacy.\n\n&lt;color=#40cbde&gt;Customizable in the styling station or Mechanicus forge altar&lt;/color&gt;.</description>
		<!-- Removed for now to avoid confusion with powerpack mention, replace above once the system is back in place
		<description>A powered backpack, designed for the usage of the Mechanicus arsenal by the Skitarii forces.\n\n&lt;color=#40cbde&gt;Customizable in the styling station or Mechanicus forge altar&lt;/color&gt;.\n\n&lt;color=#bb8f04&gt;Powerpack or power source&lt;/color&gt;.</description> -->
