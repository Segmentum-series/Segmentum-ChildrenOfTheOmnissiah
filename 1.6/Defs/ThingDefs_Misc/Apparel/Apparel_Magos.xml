<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThingDef Abstract="true" Name="Seg_COTO_MagosBase" ParentName="ArmorMachineableBase">
		<thingClass>Apparel</thingClass>
		<graphicData>
			<drawSize>1.0</drawSize>
		</graphicData>
		<thingCategories>
			<li>Apparel</li>
		</thingCategories>
		<tradeTags>
			<li>Seg_COTO_Robe</li>
		</tradeTags>
		<apparel>
			<useWornGraphicMask>true</useWornGraphicMask>
			<tags>
				<li>Seg_COTO_Robe</li>
			</tags>
			<countsAsClothingForNudity>true</countsAsClothingForNudity>
			<defaultOutfitTags>
				<li>Worker</li>
			</defaultOutfitTags>
		</apparel>
		<comps>
			<li Class="Core40k.CompProperties_MultiColor" MayRequire="phonicmas.rimdark.frameworkcore">
				<defaultPrimaryColor>(0.56, 0.03, 0.06)</defaultPrimaryColor>
				<defaultSecondaryColor>(0.95, 0.90, 0.75)</defaultSecondaryColor>
				<tabDefs>
					<li>BEWH_ExtraDecoration</li>
				</tabDefs>
			</li>
		</comps>
		
		<recipeMaker>
			<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
			<workSkill>Crafting</workSkill>
			<effectWorking>Tailor</effectWorking>
			<soundWorking>Recipe_Tailor</soundWorking>
			<unfinishedThingDef>UnfinishedApparel</unfinishedThingDef>
			<recipeUsers Inherit="False">
				<li>Seg_COTO_CraftingTable</li>
			</recipeUsers>
		</recipeMaker>
	</ThingDef>

	<!-- Magos hood -->
	<ThingDef ParentName="Seg_COTO_MagosBase">
		<defName>Seg_COTO_Apparel_MagosHood</defName>
		<label>magos hood</label>
		<description>A simple magos hood, utilized by new and low ranking Magos according to doctrine.\n\n&lt;color=#40cbde&gt;Customizable in the styling station or Mechanicus forge altar&lt;/color&gt;.</description>

		<graphicData>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>Cutout</shaderType>
			<texPath>Things/Apparel/MagosHood/Seg_COTO_MagosHood</texPath>
		</graphicData>

		<statBases>
			<WorkToMake>10000</WorkToMake>
			<MaxHitPoints>350</MaxHitPoints>
			<Mass>2.2</Mass>
			<StuffEffectMultiplierArmor>0.5</StuffEffectMultiplierArmor>
			<StuffEffectMultiplierInsulation_Cold>0</StuffEffectMultiplierInsulation_Cold>
			<StuffEffectMultiplierInsulation_Heat>0.2</StuffEffectMultiplierInsulation_Heat>
		</statBases>
		<equippedStatOffsets>
			<WorkSpeedGlobal>.05</WorkSpeedGlobal>
		</equippedStatOffsets>

		<costList>
			<Steel>20</Steel>
			<ComponentIndustrial>1</ComponentIndustrial>
		</costList>
			<stuffCategories>
				<li>Fabric</li>
			</stuffCategories>
			<costStuffCount>40</costStuffCount>

		<apparel>
			<useWornGraphicMask>true</useWornGraphicMask>
			<tags>
				<li>Seg_COTO_Hood</li>
				<li>Seg_COTO_Magos</li>
			</tags>
			<countsAsClothingForNudity>true</countsAsClothingForNudity>
			<bodyPartGroups>
				<li>Neck</li>
				<li>UpperHead</li>
			</bodyPartGroups>
			<layers>
				<li>Overhead</li>
			</layers>
			<defaultOutfitTags>
				<li>Worker</li>
			</defaultOutfitTags>
			<wornGraphicPaths>
				<li>Things/Apparel/MagosHood/Seg_COTO_MagosHood</li>
			</wornGraphicPaths>
		</apparel>
		<recipeMaker>
			<researchPrerequisites>
				<li>Seg_COTO_CultMechanicus</li>
			</researchPrerequisites>
			<skillRequirements>
				<Crafting>4</Crafting>
			</skillRequirements>
		</recipeMaker>
		
		<comps>
			<li Class="Core40k.CompProperties_Decorative">
				<decorativeType>Head</decorativeType>
			</li>
		</comps>
	</ThingDef>

	<!-- Magos robe -->
	<ThingDef ParentName="Seg_COTO_MagosBase">
		<defName>Seg_COTO_Apparel_MagosRobes</defName>
		<label>magos robe</label>
		<description>A basic robe utilized by new and low ranking Magos. While offering some degree of protection to the wearer, it's not designed for frontline service.\n\n&lt;color=#40cbde&gt;Customizable in the styling station or Mechanicus forge altar&lt;/color&gt;.</description>
		<graphicData>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>Cutout</shaderType>
			<texPath>Things/Apparel/MagosRobe/Seg_COTO_MagosRobe</texPath>
		</graphicData>

		<statBases>
			<WorkToMake>12000</WorkToMake>
			<MaxHitPoints>350</MaxHitPoints>
			<Mass>2.2</Mass>
			<StuffEffectMultiplierArmor>0.3</StuffEffectMultiplierArmor> <!-- the duster armor is already rather high, maybe up this? idk what do you think abo-->
			<StuffEffectMultiplierInsulation_Cold>0.10</StuffEffectMultiplierInsulation_Cold>
			<StuffEffectMultiplierInsulation_Heat>0.65</StuffEffectMultiplierInsulation_Heat>
		</statBases>
		<equippedStatOffsets>
			<SocialImpact>.15</SocialImpact>
			<ResearchSpeed>.10</ResearchSpeed>
		</equippedStatOffsets>

		<costList>
			<Steel>20</Steel>
			<ComponentIndustrial>1</ComponentIndustrial>
		</costList>
		<stuffCategories>
			<li>Fabric</li>
		</stuffCategories>
		<costStuffCount>40</costStuffCount>

		<apparel>
			<useWornGraphicMask>true</useWornGraphicMask>
			<tags>
				<li>Seg_COTO_MagosRobes</li>
			</tags>
			<countsAsClothingForNudity>true</countsAsClothingForNudity>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Shoulders</li>
				<li>Neck</li>
			</bodyPartGroups>
			<layers>
				<li>Shell</li>
			</layers>
			<defaultOutfitTags>
				<li>Worker</li>
			</defaultOutfitTags>
			<wornGraphicPaths>
				<li>Things/Apparel/MagosRobe/Seg_COTO_MagosRobe</li>
			</wornGraphicPaths>
		</apparel>
		<recipeMaker>
			<researchPrerequisites>
				<li>Seg_COTO_CultMechanicus</li>
			</researchPrerequisites>
			<skillRequirements>
				<Crafting>4</Crafting>
			</skillRequirements>
		</recipeMaker>

		<comps>
			<li Class="Core40k.CompProperties_Decorative">
				<decorativeType>Body</decorativeType>
			</li>
		</comps>
	</ThingDef>

	<!-- Magos cassock -->
	<ThingDef ParentName="Seg_COTO_MagosBase">
		<defName>Seg_COTO_Apparel_MagosCassock</defName>
		<label>magos cassock</label>
		<description>Regular uniforms utilized by the cultists of the Mechanicus. Usually a common sight around priets of Forge Worlds, it may be replaced by higher ranking members by more distinct apparel, suited for their tasks and augmented body needs.\n\n&lt;color=#40cbde&gt;Customizable in the styling station or Mechanicus forge altar&lt;/color&gt;.</description>

		<graphicData>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>Cutout</shaderType>
			<texPath>Things/Apparel/MagosCassock/Seg_COTO_MagosCassock</texPath>
		</graphicData>

		<statBases>
			<WorkToMake>12000</WorkToMake>
			<MaxHitPoints>350</MaxHitPoints>
			<Mass>2.2</Mass>
			<StuffEffectMultiplierArmor>0.25</StuffEffectMultiplierArmor>
			<StuffEffectMultiplierInsulation_Cold>0.25</StuffEffectMultiplierInsulation_Cold>
			<StuffEffectMultiplierInsulation_Heat>0.45</StuffEffectMultiplierInsulation_Heat>
		</statBases>
		<equippedStatOffsets>
			<ConstructionSpeed>.20</ConstructionSpeed>
			<ConstructSuccessChance>.20</ConstructSuccessChance>
		</equippedStatOffsets>
		<costList>
			<Steel>20</Steel>
			<ComponentIndustrial>1</ComponentIndustrial>
		</costList>

		<stuffCategories>
			<li>Fabric</li>
		</stuffCategories>
		<costStuffCount>40</costStuffCount>

		<apparel>
			<useWornGraphicMask>true</useWornGraphicMask>
			<tags>
				<li>Seg_COTO_MagosCassock</li>
			</tags>
			<countsAsClothingForNudity>true</countsAsClothingForNudity>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Shoulders</li>
				<li>Neck</li>
				<li>Arms</li>
				<li>Legs</li>
			</bodyPartGroups>
			<layers>
				<li>Middle</li>
			</layers>
			<defaultOutfitTags>
				<li>Worker</li>
			</defaultOutfitTags>
			<wornGraphicPaths>
				<li>Things/Apparel/MagosCassock/Seg_COTO_MagosCassock</li>
			</wornGraphicPaths>
		</apparel>
		<recipeMaker>
			<researchPrerequisites>
				<li>Seg_COTO_CultMechanicus</li>
			</researchPrerequisites>
			<skillRequirements>
				<Crafting>4</Crafting>
			</skillRequirements>
		</recipeMaker>
		<comps>
			<li Class="Core40k.CompProperties_Decorative">
				<decorativeType>Body</decorativeType>
			</li>
		</comps>
	</ThingDef>
</Defs>
