			<Steel>10</Steel>
			<ComponentIndustrial>1</ComponentIndustrial>
		</costList>
			<stuffCategories>
				<li>Fabric</li>
				<li>Leathery</li>
			</stuffCategories>
			<costStuffCount>30</costStuffCount>

		<apparel>
			<useWornGraphicMask>true</useWornGraphicMask>
			<tags>
				<li>Seg_COTO_Hood</li>
				<li>Seg_COTO_Magos</li>
			</tags>
			<countsAsClothingForNudity>true</countsAsClothingForNudity>
			<bodyPartGroups>
				<li>Neck</li>
				<li>UpperHead</li>
			</bodyPartGroups>
			<layers>
				<li>Overhead</li>
			</layers>
			<defaultOutfitTags>
				<li>Worker</li>
			</defaultOutfitTags>
			<wornGraphicPaths>
				<li>Things/Apparel/MagosHood/Seg_COTO_MagosHood</li>
