	<!-- Macrostubber -->
	<ThingDef ParentName="Seg_COTO_Stubber_base">
		<defName>Seg_COTO_Gun_Macrostubber</defName>
		<label>macrostubber</label>
		<description>Favoured by Tech-Priests, macrostubbers are able to hurl out a thunderous cloud of solid slugs.</description>
		<graphicData>
			<texPath>Things/Weapon/Seg_COTO_Ranged_Macrostubber</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1.4</drawSize>
			<shaderType>Cutout</shaderType>
		</graphicData>
		<uiIconScale>1.1</uiIconScale>
		<soundInteract>Interact_Rifle</soundInteract>
		<recipeMaker>
			<!-- <researchPrerequisites>
				<li>Seg_COTO_CultMechanicus</li>
			</researchPrerequisites> -->
			<skillRequirements>
				<Crafting>6</Crafting>
			</skillRequirements>
		</recipeMaker>
		<statBases>
			<WorkToMake>24000</WorkToMake>
			<Mass>2.8</Mass>
			<AccuracyTouch>0.90</AccuracyTouch>
			<AccuracyShort>0.65</AccuracyShort>
			<AccuracyMedium>0.40</AccuracyMedium>
			<AccuracyLong>0.20</AccuracyLong>
			<RangedWeapon_Cooldown>1.0</RangedWeapon_Cooldown>
			<MarketValue>420</MarketValue>
		</statBases>
		<costList>
			<Steel>60</Steel>
			<ComponentIndustrial>5</ComponentIndustrial>
		</costList>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Seg_COTO_Bullet_Stubber</defaultProjectile>
				<warmupTime>0.7</warmupTime>
				<range>22.9</range>
				<burstShotCount>3</burstShotCount>
				<ticksBetweenBurstShots>10</ticksBetweenBurstShots>
				<!-- <soundCast>Seg_COTO_StubberSound</soundCast> -->
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<!-- Tags for trading and categorization for later
		<weaponTags>
			<li>ShortShots</li>
			<li>Gun</li>
			<li>IndustrialGunAdvanced</li>
		</weaponTags>
		<tradeTags>
			<li>Seg_COTO_WeaponRangedLowTier</li>
		</tradeTags>
		-->
	</ThingDef>

