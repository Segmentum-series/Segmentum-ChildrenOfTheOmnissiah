	<!-- Macrostubber -->
	<ThingDef ParentName="Seg_COTO_Stubber_base">
		<defName>Seg_COTO_Gun_Macrostubber</defName>
		<label>macrostubber</label>
		<description>Favoured by Tech-Priests, macrostubbers are able to hurl out a thunderous cloud of solid slugs.</description>
