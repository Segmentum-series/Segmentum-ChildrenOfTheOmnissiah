	<!-- Arc Pistol -->
	<ThingDef ParentName="Seg_COTO_ArcWeaponBase">
		<defName>Seg_COTO_Gun_ArcPistol</defName>
		<label>arc pistol</label>
		<description>A smaller, lighter, and more portable variant of arc weaponry. Despite its size, it will still fry more than a motherboard.\n\n&lt;color=#40cbde&gt;Danger:&lt;/color&gt; This weapon will damage everything in a line in front of it. Causes electric damage.\n\n&lt;color=#bb8f04&gt;Requires a powerpack or power source&lt;/color&gt;.</description>
		<graphicData>
			<texPath>Things/Weapon/Seg_COTO_Ranged_ArcPistol</texPath>
			<shaderType>Cutout</shaderType>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1.3</drawSize>
		</graphicData>
		<uiIconScale>1.4</uiIconScale>

		<statBases>
			<Mass>2.5</Mass>
			<EquipDelay>0.5</EquipDelay>
			<RangedWeapon_Cooldown>1</RangedWeapon_Cooldown>
			<AccuracyTouch>0.90</AccuracyTouch>
			<AccuracyShort>0.60</AccuracyShort>
			<AccuracyMedium>0.35</AccuracyMedium>
			<AccuracyLong>0.25</AccuracyLong>
			<WorkToMake>24000</WorkToMake>
			<MarketValue>1100</MarketValue>
		</statBases>

		<verbs>
			<li Class="BM_HeavyWeapon.VerbProperties_ApparelAmmo">
				<verbClass>BM_HeavyWeapon.Verb_Shoot_ApparelAmmo</verbClass>
				<apparelList>
					<li>Seg_COTO_Apparel_MagosBackpack</li>
					<li>Seg_COTO_Apparel_MarshalBackpack</li>
					<li>Seg_COTO_Apparel_SkitariiBackpack</li>
					<li MayRequire="RedMattis.BetterPrerequisites">Seg_COTO_Apparel_SicarianBackpack</li>
				</apparelList>
				<missingReason>Missing a source of energy. Equip a powerpack first.</missingReason>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Seg_COTO_ArcPistol_Beam</defaultProjectile>
				<soundCast>Seg_COTO_ArcSound</soundCast>
				<warmupTime>0.50</warmupTime>
				<range>15.9</range>
				<burstShotCount>1</burstShotCount>
				<muzzleFlashScale>10</muzzleFlashScale>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
			</li>
		</verbs>

		<costList>
			<Steel>40</Steel>
			<ComponentIndustrial>5</ComponentIndustrial>
			<Uranium>5</Uranium>
		</costList>

		<recipeMaker>
			<researchPrerequisites>
				<li>Seg_COTO_TechGuard</li>
			</researchPrerequisites>
			<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
			<workSkill>Crafting</workSkill>
			<skillRequirements>
			<Crafting>8</Crafting>
			</skillRequirements>
		</recipeMaker>
		<!-- Tags for trading and categorization for later-->
		<weaponTags>
			<li>Seg_COTO_Arc</li>
			<li>Seg_COTO_MagosAdvancedRanged</li>
		</weaponTags>
		<tradeTags>
			<li>Seg_COTO_WeaponRangedMidTier</li>
		</tradeTags>
		<comps>
		<li Class="WeaponOverlayTex.CompProperties_WeaponOverlay">
            <TexturePath>Things/Weapon/Seg_LEND_ArcPistol_e</TexturePath>
            <ShaderTypeDefName>TransparentPostLight</ShaderTypeDefName>
            <OnlyDuringWarmup>true</OnlyDuringWarmup>
            <WarmupFadeInTicks>5</WarmupFadeInTicks>
		</li>
		</comps>
	</ThingDef>

	<!-- Arc rifle -->
	<ThingDef ParentName="Seg_COTO_ArcWeaponBase">
		<defName>Seg_COTO_Gun_ArcRifle</defName>
		<label>arc rifle</label>
		<description>A rapid firing arc weapon that discharges directed energy blasts with a loud crack, firing blots of blue-white electricity that can fry a creature's brain or overload a war machine's data-cortex in a solar second.\n\n&lt;color=#40cbde&gt;Danger:&lt;/color&gt; This weapon will damage everything in a line in front of it. Causes electric damage.\n\n&lt;color=#bb8f04&gt;Requires a powerpack or power source&lt;/color&gt;.</description>
		<equippedAngleOffset>45</equippedAngleOffset>
		<graphicData>
			<texPath>Things/Weapon/Seg_COTO_Ranged_ArcRifle</texPath>
			<shaderType>Cutout</shaderType>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1.3</drawSize>
		</graphicData>
		<uiIconScale>1</uiIconScale>
		<statBases>
			<Mass>4.5</Mass>
			<EquipDelay>0.5</EquipDelay>
			<RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>
			<AccuracyTouch>0.90</AccuracyTouch>
			<AccuracyShort>0.60</AccuracyShort>
			<AccuracyMedium>0.35</AccuracyMedium>
			<AccuracyLong>0.20</AccuracyLong>
			<WorkToMake>36000</WorkToMake>
			<MarketValue>2000</MarketValue>
		</statBases>

		<verbs>
			<!-- Replace the <li> + <verbClass bellow once BM_HeavyWeapons get re-introduced-->
			<li Class="BM_HeavyWeapon.VerbProperties_ApparelAmmo">
				<verbClass>BM_HeavyWeapon.Verb_Shoot_ApparelAmmo</verbClass>
				<apparelList>
					<li>Seg_COTO_Apparel_MagosBackpack</li>
					<li>Seg_COTO_Apparel_MarshalBackpack</li>
					<li>Seg_COTO_Apparel_SkitariiBackpack</li>
					<li MayRequire="RedMattis.BetterPrerequisites">Seg_COTO_Apparel_SicarianBackpack</li>
				</apparelList>
				<missingReason>Missing a source of energy. Equip a powerpack first.</missingReason>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Seg_COTO_ArcPistol_Beam</defaultProjectile>
				<warmupTime>0.75</warmupTime>
				<range>35.9</range>
				<burstShotCount>1</burstShotCount>
				<ticksBetweenBurstShots>10</ticksBetweenBurstShots>
				<soundCast>Seg_COTO_ArcSound</soundCast>
				<muzzleFlashScale>10</muzzleFlashScale>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
			</li>
		</verbs>

		<costList>
			<Steel>70</Steel>
			<ComponentIndustrial>8</ComponentIndustrial>
			<Uranium>5</Uranium>
		</costList>
		<recipeMaker>
			<researchPrerequisites>
				<li>Seg_COTO_ManipleTactics</li>
			</researchPrerequisites>
			<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
			<workSkill>Crafting</workSkill>
			<skillRequirements>
			<Crafting>10</Crafting>
			</skillRequirements>
		</recipeMaker>
		<comps>
			<li Class="Core40k.CompProperties_AmmoChanger">
				<compClass>Core40k.Comp_AmmoChanger</compClass>
				<availableProjectiles>
				<li>Seg_COTO_ArcPistol_Beam</li>
				<li>Seg_COTO_ArcRifleOverCharged_Beam</li>
				</availableProjectiles>
			</li>
		<li Class="WeaponOverlayTex.CompProperties_WeaponOverlay">
            <TexturePath>Things/Weapon/Seg_LEND_ArcRifle_e</TexturePath>
            <ShaderTypeDefName>TransparentPostLight</ShaderTypeDefName>
            <OnlyDuringWarmup>true</OnlyDuringWarmup>
            <WarmupFadeInTicks>5</WarmupFadeInTicks>
      </li>
		</comps> 

		<modExtensions>
			<li Class="VEF.Things.ThingDefExtension">
				<weaponCarryDrawOffsets>
					<east>
						<drawOffset>(0, 0, -0.07)</drawOffset>
					</east>
					<south>
						<angleOffset>-20</angleOffset>
						<drawOffset>(0, 0, -0.07)</drawOffset>
					</south>
					<west>
						<drawOffset>(0, 0, -0.07)</drawOffset>
					</west>
				</weaponCarryDrawOffsets>
			</li>
		</modExtensions>
		<!-- Tags for trading and categorization for later-->
		<weaponTags>
			<li>Seg_COTO_Arc</li>
		</weaponTags>
		<tradeTags>
			<li>Seg_COTO_WeaponRangedMidTier</li>
		</tradeTags>
	</ThingDef>


