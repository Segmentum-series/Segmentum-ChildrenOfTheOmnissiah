	<ThingDef ParentName="BaseBullet">
		<defName>Seg_COTO_Bullet_Galvanic</defName>
		<label>high-velocity servitor-bullet</label>
		<description>Fires a two-round burst of the standard servitor-bullet designed for use with the galvanic rifle, capable of shredding through flesh and armour alike.</description>
		<graphicData>
			<texPath>Things/Projectile/Seg_COTO_Radium</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<uiIconPath>UI/Projectile/Seg_COTO_UI_GalvanicBullet</uiIconPath>
		<projectile>
			<damageDef>Bullet</damageDef>
			<damageAmountBase>18</damageAmountBase>
			<stoppingPower>3</stoppingPower>
		<speed>300</speed>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="BaseBullet">
		<defName>Seg_COTO_Bullet_GalvanicSeeker</defName>
		<label>brain seeker servitor-bullet</label>
		<description>Fires a single advanced version of the high-velocity servitor-bullet. The machine spirit of the round is capable of altering its trajectory mid-flight to ensure it hits its target where it hurts.</description>
		<graphicData>
			<texPath>Things/Projectile/Seg_COTO_BrainBullet</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<uiIconPath>UI/Projectile/Seg_COTO_UI_BrainBullet</uiIconPath>
		<projectile>
			<damageDef>Bullet</damageDef>
			<damageAmountBase>20</damageAmountBase>
			<stoppingPower>3</stoppingPower>
		<speed>90</speed>
		</projectile>
		<recipeMaker>
			<researchPrerequisite>Seg_COTO_TechGuardAdvanced</researchPrerequisite>
		</recipeMaker>
		<costList>
			<ComponentIndustrial>1</ComponentIndustrial>
		</costList>
		<comps>
		<li Class="taranchuk_homingprojectiles.CompProperties_HomingProjectile">
				<tickRate>10</tickRate> <!--this changes the rate this updates-->
				<lifetimeTicks>30000</lifetimeTicks> <!--once this runs out, it disintegrates, used for things like missiles running out of fuel and disarming-->
				<delayTurnInTicks>5</delayTurnInTicks> <!--how soon after firing the projectile begins tracking-->
				<initialSpreadAngle>20</initialSpreadAngle> <!--the degrees allowed for it to spread when fired, this is for things like micromissile swarms that you would imagine converging on your target-->
				<tailMote>CracksShieldBreak</tailMote> <!--This gives it a trail of a specific mote-->
				<effectLifetime>30</effectLifetime> <!--the life of those motes-->
				<effectSize>1</effectSize> <!--the size of the motes-->
				</li>
		</comps>
		<modExtensions>
			<li Class="Core40k.DefModExtension_AmmoChanger">
				<unlockedBy>Seg_COTO_TechGuardAdvanced</unlockedBy>
				<effectiveRange>55.9</effectiveRange>
				<warmupTime>3.25</warmupTime>
				<shotsPerBurst>1</shotsPerBurst>
			</li>
		</modExtensions>
	</ThingDef>

