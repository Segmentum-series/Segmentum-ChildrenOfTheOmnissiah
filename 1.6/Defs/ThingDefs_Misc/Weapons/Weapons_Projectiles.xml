<!-- Arc -->
	<!-- Arc pistol -->
	<ThingDef ParentName="BaseBullet">
  		<defName>Seg_COTO_ArcPistol_Beam</defName>
  		<label>arc beam</label>
  		<description>Projects the Motive Force at a target and can arc to other targets with electrifying effect.</description>
		<thingClass>taranchuk_lasers.LaserProjectile</thingClass>
		<category>Projectile</category>
		<drawOffscreen>true</drawOffscreen>
		<seeThroughFog>true</seeThroughFog>

		<graphicData>
			<graphicClass>Graphic_Single</graphicClass>
			<texPath>Things/Projectile/Seg_COTO_Arc</texPath>
			<shaderType>TransparentPostLight</shaderType>
			<drawSize>2</drawSize>
		</graphicData>

		<projectile>
			<damageDef>Seg_COTO_ArcDamage</damageDef>
			<damageAmountBase>2</damageAmountBase>
			<armorPenetrationBase>2.00</armorPenetrationBase>
			<stoppingPower>0.2</stoppingPower>
			<speed>999</speed>
		</projectile>

		<modExtensions>
			<li Class="taranchuk_lasers.LaserProperties">
				<damageTickRate>10</damageTickRate>
				<lifetimeTicks>20</lifetimeTicks>

				<beamWidth>0.45</beamWidth>
				<beamWidthDrawScale>2.5</beamWidthDrawScale>

				<sweepRatePerTick>0</sweepRatePerTick>
				<maxSweepAngle>0</maxSweepAngle>

				<damageThingsAcrossBeamLine>false</damageThingsAcrossBeamLine>
				<debugCells>false</debugCells>

				<textureScrollOffsetPerTick>(0, 0.1)</textureScrollOffsetPerTick>
				<lockOnTarget>false</lockOnTarget>
				
				<maxChainTargets>2</maxChainTargets>
				<chainDamageFalloff>0.80</chainDamageFalloff>
				<branchChance>1</branchChance>
				<maxBranches>2</maxBranches>
				<branchToSameTargets>false</branchToSameTargets>
				<chainAllowFriendlyFire>true</chainAllowFriendlyFire>
				<chainToAnything>False</chainToAnything>
				<chainRange>2</chainRange>
				<chainDelayTicks>1</chainDelayTicks>

				<sustainerSoundDef>Seg_COTO_ElectricArc</sustainerSoundDef>
				<trailSoundDef>Seg_COTO_ElectricArcEnd</trailSoundDef>
			</li>
		</modExtensions>
	</ThingDef>
