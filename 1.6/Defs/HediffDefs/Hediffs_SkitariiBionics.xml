<!-- HediffDef -->
<HediffDef ParentName="ImplantHediffBase">
  <defName>Seg_COTO_SkitariiDataUplink_Hediff</defName>
  <label>data uplink</label>
  <labelNoun>a data uplink implant</labelNoun>
  <hediffClass>HediffWithComps</hediffClass>
  <description>An installed cranial implant which adds a basic noospheric connection and feeds combat and situational data directly to the bearer's neural cortex. Skitarii officers make use of these implants to better understand, analyse, and command on any battlefield the Machine Cult requires them to fight on.</description>
  <spawnThingOnRemoved>Seg_COTO_SkitariiDataUplink</spawnThingOnRemoved>
 



  <stages>
    <li>
      <statOffsets>
	     <SocialImpact>.05</SocialImpact>
         <MeleeDodgeChance>.05</MeleeDodgeChance>
      </statOffsets>
      <painOffset>0.01</painOffset>
	  <!--Command aura boosting allied pawns' combat stats slightly-->
    </li>
  </stages>
  <comps>
  <li Class="DoggoAura.HediffCompProperties_HediffAura">
  <range>9.9</range>
  <targetingParameters>
    <canTargetPawns>True</canTargetPawns>
    <canTargetBuildings>False</canTargetBuildings>
  </targetingParameters>
