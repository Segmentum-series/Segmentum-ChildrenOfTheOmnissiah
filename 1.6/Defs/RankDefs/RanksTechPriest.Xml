    <Defs>
    <Seg.RankDef>
        <defName>Seg_COTO_TechAcolytum</defName>
        <label>Tech Acolytum</label>
        <description>An apprentice in the mysteries of the Machine Cult. Tech Acolyta are treated little better than menials, but may be destined for great things.</description>
        <rankIconPath>UI/Decoration/Icons/MagosRobe/Seg_COTO_Deco_MagosRobe_GearStripe</rankIconPath>
        <rankTier>1</rankTier>
        <!-- <requiredAgeRange>(7, 99999)</requiredAgeRange> -->
    

        <statOffsets>
            
            <WorkSpeedGlobal>0.025</WorkSpeedGlobal>
        </statOffsets>
         <statFactors>
            <GlobalLearningFactor>1.01</GlobalLearningFactor>
        </statFactors>
    </Seg.RankDef>
    <Seg.RankDef>
        <defName>Seg_COTO_AdeptProbatoris</defName>
        <label>Adept Probatoris</label>
        <description>Having graduated beyond the acolyta, the Adept Probatoris is preparing to be ordained as a full tech-adept of the Machine Cult.</description>
        <rankIconPath>UI/Decoration/Icons/MagosRobe/Seg_COTO_Deco_MagosRobe_GearStripe</rankIconPath>
        <rankTier>2</rankTier>
        <!-- <requiredAgeRange>(13, 99999)</requiredAgeRange> -->
        <!-- <impantRequirements>1</impantRequirements> truly a fuckin GUESS, waiting for conformation from pho on this-->
    

        <statOffsets>
           
            <BEWH_ArtificialPartsAffinityFactor>0.05</BEWH_ArtificialPartsAffinityFactor>
            <WorkSpeedGlobal>0.025</WorkSpeedGlobal>
            <ResearchSpeed>0.05</ResearchSpeed>

        </statOffsets>
         <statFactors>
            <GlobalLearningFactor>1.02</GlobalLearningFactor>
        </statFactors>
    </Seg.RankDef>
      <Seg.RankDef>
        <defName>Seg_COTO_Enginseer</defName>
        <label>Enginseer</label>
        <description>One of the most commonly seen techpriests among the wider Imperial population, enginseers are skilled at maintaining and repairing the equipment and machinery the Imperium relies on, but are sometimes looked down on as mere tinkerers by more intellectually-minded magi.</description>
        <rankIconPath>UI/Decoration/Icons/MagosRobe/Seg_COTO_Deco_MagosRobe_GearStripe</rankIconPath>
        <rankTier>3</rankTier>
          <incompatibleRanks>
            <li>Seg_COTO_Transmechanic</li>
            <li>Seg_COTO_Lexmechanic</li>
            <li>Seg_COTO_MagosBiologis</li>
            <li>Seg_COTO_Explorator</li>
            
            <li>Seg_COTO_AuxiliusMyrmidon</li>
        </incompatibleRanks>
        <!-- <requiredAgeRange>(13, 99999)</requiredAgeRange> -->
        <ImplantsRequired>2</ImplantsRequired>
        <requiredSkills>
            <Crafting>6</Crafting>
        </requiredSkills>

        <statOffsets>

            <BEWH_ArtificialPartsAffinityFactor>0.05</BEWH_ArtificialPartsAffinityFactor>
            <WorkSpeedGlobal>0.025</WorkSpeedGlobal>
            <!-- <ConstructionSuccessChance>0.5</ConstructionSuccessChance> -->


        </statOffsets>
    </Seg.RankDef>
     <Seg.RankDef>
        <defName>Seg_COTO_Transmechanic</defName>
        <label>Transmechanic</label>
        <description>Transmechanics are communications and scanning technology specialists and are frequently seconded to Imperial Navy voidships to operate auspex and vox equipment.</description>
        <rankIconPath>UI/Decoration/Icons/MagosRobe/Seg_COTO_Deco_MagosRobe_GearStripe</rankIconPath>
        <rankTier>3</rankTier>
          <incompatibleRanks>
            <li>Seg_COTO_Enginseer</li>
            <li>Seg_COTO_Lexmechanic</li>
            <li>Seg_COTO_MagosBiologis</li>
            <li>Seg_COTO_Explorator</li>
            
            <li>Seg_COTO_AuxiliusMyrmidon</li>
        </incompatibleRanks>
        <!-- <requiredAgeRange>(13, 99999)</requiredAgeRange> -->
        <ImplantsRequired>2</ImplantsRequired>
        <requiredSkills>
            <Crafting>4</Crafting>
            <Intellectual>6</Intellectual>
        </requiredSkills>

        <statOffsets>

            <HackingSpeed>0.20</HackingSpeed>
            <WorkSpeedGlobal>0.025</WorkSpeedGlobal>
            <PilotingAbility MayRequire="Ludeon.RimWorld.Odyssey"> 0.5</PilotingAbility>


        </statOffsets>
    </Seg.RankDef>
     <Seg.RankDef>
        <defName>Seg_COTO_Lexmechanic</defName>
        <label>Lexmechanic</label>
        <description>One of the most numerous branches of the Cult, lexmechanics are analysts, researchers, compilers and administrators who are crucial to the running of any Mechanicus or Imperial facility.</description>
        <rankIconPath>UI/Decoration/Icons/MagosRobe/Seg_COTO_Deco_MagosRobe_GearStripe</rankIconPath>
        <rankTier>3</rankTier>
          <incompatibleRanks>
            <li>Seg_COTO_Transmechanic</li>
            <li>Seg_COTO_Enginseer</li>
            <li>Seg_COTO_MagosBiologis</li>
            <li>Seg_COTO_Explorator</li>
            
            <li>Seg_COTO_AuxiliusMyrmidon</li>
        </incompatibleRanks>
        <!-- <requiredAgeRange>(13, 99999)</requiredAgeRange> -->
        <ImplantsRequired>2</ImplantsRequired>
        <requiredSkills>
            <Crafting>6</Crafting>
        </requiredSkills>
         <recreationFromSkills>
            <li>Intellectual</li>
        </recreationFromSkills>

        <statOffsets>

            <ResearchSpeed>0.10</ResearchSpeed>
            
            <ReadingSpeed>0.30</ReadingSpeed>

        </statOffsets>
         <statFactors>
            <GlobalLearningFactor>1.05</GlobalLearningFactor>
        </statFactors>
    </Seg.RankDef>
     <Seg.RankDef>
        <defName>Seg_COTO_MagosBiologis</defName>
        <label>Magos Biologis</label>
        <description>Expert in the fields of biology, anatomy, and xenofauna, a Magos Biologis has dedicated their life to the study of the organic.</description>
        <rankIconPath>UI/Decoration/Icons/MagosRobe/Seg_COTO_Deco_MagosRobe_GearStripe</rankIconPath>
        <rankTier>3</rankTier>
          <incompatibleRanks>
            <li>Seg_COTO_Transmechanic</li>
            <li>Seg_COTO_Lexmechanic</li>
            <li>Seg_COTO_Enginseer</li>
            <li>Seg_COTO_Explorator</li>
             <li>Seg_COTO_AuxiliusMyrmidon</li>
        </incompatibleRanks>
        <!-- <requiredAgeRange>(13, 99999)</requiredAgeRange> -->
        <ImplantsRequired>2</ImplantsRequired>
        <requiredSkills>
            <Plants>6</Plants>
            <Animals>3</Animals>
            <Medicine>6</Medicine>
        </requiredSkills>
         <givesPassions>
            <li>
            <skill>Plants</skill>
            <modType>AddOneLevel</modType> </li>
             <li>
            <skill>Animals</skill>
            <modType>AddOneLevel</modType> </li>
             <li>
            <skill>Medicine</skill>
            <modType>AddOneLevel</modType> </li>
        </givesPassions>
        <statOffsets>

            <MedicalTendQuality>0.1</MedicalTendQuality>
            <WorkSpeedGlobal>0.025</WorkSpeedGlobal>
            <PlantWorkSpeed>0.20</PlantWorkSpeed>


        </statOffsets>
        <!--<modExtensions>
            <li Class="VEF.Genes.GeneExtension">
                <skillRecreation>Plants</skillRecreation>
                <skillRecreation>Animals</skillRecreation>
            </li>
        </modExtensions> -->
    </Seg.RankDef>
    <Seg.RankDef>
        <defName>Seg_COTO_Explorator</defName>
        <label>Explorator</label>
        <description>The Quest for Knowledge is a core tenet for all priests of the Cult Mechanicus, but Explorators put it into action most practically by setting out to 'recover' undiscovered data, technology, and habitable worlds.</description>
        <rankIconPath>UI/Decoration/Icons/MagosRobe/Seg_COTO_Deco_MagosRobe_GearStripe</rankIconPath>
        <rankTier>3</rankTier>
          <incompatibleRanks>
            <li>Seg_COTO_Transmechanic</li>
            <li>Seg_COTO_Lexmechanic</li>
            <li>Seg_COTO_Enginseer</li>
            <li>Seg_COTO_MagosBiologis</li>
            <li>Seg_COTO_AuxiliusMyrmidon</li>
        </incompatibleRanks>
        <ImplantsRequired>2</ImplantsRequired>
        <requiredSkills>
            <Melee>4</Melee>
            <Shooting>4</Shooting>
            <Social>4</Social>
        </requiredSkills>
        <statOffsets>
            <BEWH_ArtificialPartsAffinityFactor>0.05</BEWH_ArtificialPartsAffinityFactor>
            <NegotiationAbility>0.20</NegotiationAbility>
            <PawnTrapSpringChance>-0.50</PawnTrapSpringChance>



            


        </statOffsets>
        <statFactors>
            <GlobalLearningFactor>1.05</GlobalLearningFactor>
        </statFactors>
    </Seg.RankDef>
    <Seg.RankDef>
        <defName>Seg_COTO_AuxiliusMyrmidon</defName>
        <label>Auxilius Myrmidon</label>
        <description>While the Skitarii form the bulk of Mechanicus armies, the Auxilia Myrmidon are the Cult Militant, and a techpriest entering their ranks commits themselves to achieving the goals of the Mechanicus through war.</description>
        <rankIconPath>UI/Decoration/Icons/MagosRobe/Seg_COTO_Deco_MagosRobe_GearStripe</rankIconPath>
        <rankTier>3</rankTier>
          <incompatibleRanks>
            <li>Seg_COTO_Transmechanic</li>
            <li>Seg_COTO_Lexmechanic</li>
            <li>Seg_COTO_Enginseer</li>
            <li>Seg_COTO_MagosBiologis</li>
            <li>Seg_COTO_Explorator</li>
        </incompatibleRanks>
        <ImplantsRequired>1</ImplantsRequired>
        <requiredSkills>
            <Melee>4</Melee>
            <Shooting>4</Shooting>
            <Social>4</Social>
        </requiredSkills>
        <statOffsets>
            
            <MeleeDodgeChance>0.5</MeleeDodgeChance>
            
        </statOffsets>
         <statFactors>
            <ShootingAccuracyPawn>1.02</ShootingAccuracyPawn>
            <MeleeHitChance>1.01</MeleeHitChance>
        </statFactors>

    </Seg.RankDef>
    <Seg.RankDef>
        <defName>Seg_COTO_FabricatorMinoris</defName>
        <label>Fabricator Minoris</label>
        <description>A Fabricator Minoris has authority over the manufacturing processes and workforce of significant parts of a forgeplex, carrying out the orders of higher magi but with a good amount of independence.</description>
        <rankIconPath>UI/Decoration/Icons/MagosRobe/Seg_COTO_Deco_MagosRobe_GearStripe</rankIconPath>
        <rankTier>4</rankTier>
          <incompatibleRanks>
            <li>Seg_COTO_ServitorUnderseer</li>
        </incompatibleRanks>
        <ImplantsRequired>4</ImplantsRequired>

        <requiredSkills>
            <Crafting>6</Crafting>
            <Construction>6</Construction>
        </requiredSkills>
        <statOffsets>
            <WorkSpeedGlobal>0.10</WorkSpeedGlobal>
            <!-- <TailoringSpeed>0.10</TailoringSpeed> -->
            <ConstructionSpeed>0.10</ConstructionSpeed>
            <ConstructSuccessChance>.30 </ConstructSuccessChance>

            

        </statOffsets>
        <recreationFromSkills>
            <li>Crafting</li>
            <li>Construction</li>
        </recreationFromSkills>
        <givesPassions>
            <li>
            <skill>Crafting</skill>
            <modType>AddOneLevel</modType> </li>
             <li>
            <skill>Construction</skill>
            <modType>AddOneLevel</modType> </li>
        </givesPassions>

    </Seg.RankDef>

    <Seg.RankDef>
        <defName>Seg_COTO_ServitorUnderseer</defName>
        <label>Servitor Underseer</label>
        <description>These specialist techpriests are responsible for the maintenance and control of servitors in the field, particularly combat servitors. They are expected to be able to defend themselves if the situation calls for it.</description>
        <rankIconPath>UI/Decoration/Icons/MagosRobe/Seg_COTO_Deco_MagosRobe_GearStripe</rankIconPath>
        <rankTier>4</rankTier>
          <incompatibleRanks>
            <li>Seg_COTO_FabricatorMinoris</li>
        </incompatibleRanks>
       <ImplantsRequired>2</ImplantsRequired>
        <requiredSkills>
            <Crafting>6</Crafting>
            <Intellectual>6</Intellectual>
            <Shooting>6</Shooting>
        </requiredSkills>
        <statOffsets>
            <HackingSpeed>0.10</HackingSpeed>
            <!-- <TailoringSpeed>0.10</TailoringSpeed> -->
            <ConstructionSpeed>0.10</ConstructionSpeed>
            <ConstructSuccessChance>.30 </ConstructSuccessChance>
            <MechBandwidth MayRequire="Ludeon.RimWorld.Biotech"> 1</MechBandwidth>
            <MechRepairSpeed MayRequire="Ludeon.RimWorld.Biotech"> 0.10</MechRepairSpeed>
            

            

        </statOffsets>
         <statFactors>
            <ShootingAccuracyPawn>1.02</ShootingAccuracyPawn>
        </statFactors>
        <recreationFromSkills>
            <li>Crafting</li>
            <li>Construction</li>
        </recreationFromSkills>
        <givesPassions>
            <li>
            <skill>Crafting</skill>
            <modType>AddOneLevel</modType> </li>
             <li>
            <skill>Construction</skill>
            <modType>AddOneLevel</modType> </li>
        </givesPassions>

    </Seg.RankDef>
    <Seg.RankDef>
        <defName>Seg_COTO_MagosLogos</defName>
        <label>Magos Logos</label>
        <description>An expert analyst with a mastery of statistics, probabilities, and extrapolation of events. A Logis is often seen as a kind of prophet by the wider Cult Mechanicus..</description>
        <rankIconPath>UI/Decoration/Icons/MagosRobe/Seg_COTO_Deco_MagosRobe_GearStripe</rankIconPath>
        <rankTier>4</rankTier>
       <ImplantsRequired>4</ImplantsRequired>
        <requiredSkills>
            <Intellectual>8</Intellectual>
            <Social>6</Social>
        </requiredSkills>
        <statOffsets>
            <ResearchSpeed>0.15</ResearchSpeed>
            <ReadingSpeed>0.20</ReadingSpeed>
            <SocialImpact>.30</SocialImpact>
            <ConversionPower MayRequire="Ludeon.RimWorld.Ideology">1.25</ConversionPower>
            <!-- <IdeoligionSpreadChance MayRequire="Ludeon.RimWorld.Ideology">.25</IdeoligionSpreadChance> -->

            

        </statOffsets>
         <statFactors>
           
        </statFactors>
        <givesPassions>
             <li>
            <skill>Intellectual</skill>
            <modType>AddOneLevel</modType> </li>
        </givesPassions>

    </Seg.RankDef>
    <Seg.RankDef>
        <defName>Seg_COTO_MagosGenetor</defName>
        <label>Magos Genetor</label>
        <description>Genetors are particular experts in all things organic, and often dedicate themselves to gene therapies and other manipulations disdained by other branches who see the machine as primary.</description>
        <rankIconPath>UI/Decoration/Icons/MagosRobe/Seg_COTO_Deco_MagosRobe_GearStripe</rankIconPath>
        <rankTier>4</rankTier>
       <ImplantsRequired>4</ImplantsRequired>
        <incompatibleRanks>
            <li>Seg_COTO_MagosBiologisextremis</li>
        </incompatibleRanks>
        <requiredSkills>
            <Plants>8</Plants>
            <Animals>5</Animals>
            <Medicine>8</Medicine>
        </requiredSkills>
        <statOffsets>
            <WorkSpeedGlobal>0.025</WorkSpeedGlobal>
            <MedicalTendQuality>0.10</MedicalTendQuality>
            

        </statOffsets>
         <statFactors>
           
        </statFactors>
        <givesPassions>
             <li>
            <skill>Intellectual</skill>
            <modType>AddOneLevel</modType> </li>
        </givesPassions>

    </Seg.RankDef> 
    <Seg.RankDef>
        <defName>Seg_COTO_MagosBiologisextremis</defName>
        <label>Magos Biologis Extremis</label>
        <description>A particular expert on medical matters and surgery, often found serving as the master chirurgeon on a voidship.</description>
        <rankIconPath>UI/Decoration/Icons/MagosRobe/Seg_COTO_Deco_MagosRobe_GearStripe</rankIconPath>
        <rankTier>4</rankTier>
       <ImplantsRequired>2</ImplantsRequired>
        <incompatibleRanks>
            <li>Seg_COTO_MagosGenetor</li>
        </incompatibleRanks>
        <requiredSkills>
            <Medicine>10</Medicine>
        </requiredSkills>
        <statOffsets>
            <MedicalSurgerySuccessChance>0.30</MedicalSurgerySuccessChance>
            <MedicalTendQuality>0.40</MedicalTendQuality>
            <MedicalOperationSpeed>0.15</MedicalOperationSpeed>

        </statOffsets>
         <statFactors>
           
        </statFactors>
         <givesAbilities MayRequire="phonicmas.rimdark.mankindsfinest">
            <li>BEWH_ApothecaryEmergencyAid</li>
        </givesAbilities>
        <givesPassions>
             <li>
            <skill>Medicine</skill>
            <modType>AddOneLevel</modType> </li>
        </givesPassions>

    </Seg.RankDef>
     <Seg.RankDef>
        <defName>Seg_COTO_MagosExplorator</defName>
        <label>Magos Explorator</label>
        <description>A Magos Explorator has gained great experience and tends to be seen as a pioneering frontier type by other techpriests. Some are known to work on behalf of the Adeptus Administratum to expand the borders of the Imperium.</description>
        <rankIconPath>UI/Decoration/Icons/MagosRobe/Seg_COTO_Deco_MagosRobe_GearStripe</rankIconPath>
        <rankTier>4</rankTier>
       <ImplantsRequired>4</ImplantsRequired>
        <requiredSkills>
            <Social>8</Social>
        </requiredSkills>
        <statOffsets>
            <MoveSpeed>0.05</MoveSpeed>
            <SocialImpact>0.10</SocialImpact>
            <NegotiationAbility>0.20</NegotiationAbility>
            <Insulation_Cold>10</Insulation_Cold>
            <Insulation_Heat>10</Insulation_Heat>
            

        </statOffsets>
         <statFactors>
           <MeleeHitChance>1.02</MeleeHitChance>
        </statFactors>
        <givesPassions>
        </givesPassions>

    </Seg.RankDef> 

    <Seg.RankDef>
        <defName>Seg_COTO_MagosMilitant</defName>
        <label>Magos Militant</label>
        <description>A Magos Militant has demonstrated their aptitude in the Omnissiah's arts of war, and may now be trusted to pursue hereteks while remaining steadfast against such temptations.</description>
        <rankIconPath>UI/Decoration/Icons/MagosRobe/Seg_COTO_Deco_MagosRobe_GearStripe</rankIconPath>
        <rankTier>4</rankTier>
       <ImplantsRequired>2</ImplantsRequired>
