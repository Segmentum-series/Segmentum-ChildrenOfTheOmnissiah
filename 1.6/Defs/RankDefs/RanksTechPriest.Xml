            <li>Seg_COTO_Securtor</li>
        </incompatibleRanks>
        <requiredSkills>
            <Melee>4</Melee>
            <Shooting>5</Shooting>
        </requiredSkills>
        <statOffsets>
            <MeleeDodgeChance>0.2</MeleeDodgeChance>
            <AimingDelayFactor>-0.02</AimingDelayFactor>
            

        </statOffsets>
         <statFactors>
           <MeleeHitChance>1.02</MeleeHitChance>
           <ShootingAccuracyPawn>1.02</ShootingAccuracyPawn>
         <!-- <GlobalCertaintyLossFactor MayRequire="Ludeon.RimWorld.Odyssey">0.60</GlobalCertaintyLossFactor> -->
        </statFactors>
    
    </Seg.RankDef>
    <Seg.RankDef>
        <defName>Seg_COTO_Securtor</defName>
        <label>Securtor</label>
        <description>Secutors are techpriests who have so dedicated themselves to combat that their very bodies have been modified extensively for that purpose. They condition themselves to meditate while fighting and see battle as a way to worship the Machine God.</description>
        <rankIconPath>UI/Decoration/Icons/MagosRobe/Seg_COTO_Deco_MagosRobe_GearStripe</rankIconPath>
        <rankTier>4</rankTier>
       <ImplantsRequired>5</ImplantsRequired>
        <incompatibleRanks>
            <li>Seg_COTO_MagosMilitant</li>
        </incompatibleRanks>
        <requiredSkills>
            <Melee>8</Melee>
        </requiredSkills>
        <statOffsets>
            <MeleeDodgeChance>0.5</MeleeDodgeChance>
            
            

        </statOffsets>
         <statFactors>
           <MeleeHitChance>1.05</MeleeHitChance>
        <ShootingAccuracyPawn>1.02</ShootingAccuracyPawn>
          <MeleeWeapon_CooldownMultiplier>0.95</MeleeWeapon_CooldownMultiplier>
        <PainShockThreshold>1.05</PainShockThreshold>
        </statFactors>
    </Seg.RankDef>



