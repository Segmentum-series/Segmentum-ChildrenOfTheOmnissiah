    <Defs>
    <Core40k.RankDef>
        <defName>Seg_COTO_TechAcolytum</defName>
        <label>Tech Acolytum</label>
        <description>An apprentice in the mysteries of the Machine Cult. Tech Acolyta are treated little better than menials, but may be destined for great things.</description>
        <rankIconPath>UI/Decoration/Icons/MagosRobe/Seg_COTO_Deco_MagosRobe_GearStripe</rankIconPath>
        <rankTier>1</rankTier>
        <!-- <requiredAgeRange>(7, 99999)</requiredAgeRange> -->
    

        <statOffsets>
            <GlobalLearningFactor>0.01</GlobalLearningFactor>
            <WorkSpeedGlobal>0.025</WorkSpeedGlobal>
        </statOffsets>
    </Core40k.RankDef>
    <Core40k.RankDef>
        <defName>Seg_COTO_AdeptProbatoris</defName>
        <label>Adept Probatoris</label>
        <description>Having graduated beyond the acolyta, the Adept Probatoris is preparing to be ordained as a full tech-adept of the Machine Cult.</description>
        <rankIconPath>UI/Decoration/Icons/MagosRobe/Seg_COTO_Deco_MagosRobe_GearStripe</rankIconPath>
        <rankTier>2</rankTier>
        <!-- <requiredAgeRange>(13, 99999)</requiredAgeRange> -->
