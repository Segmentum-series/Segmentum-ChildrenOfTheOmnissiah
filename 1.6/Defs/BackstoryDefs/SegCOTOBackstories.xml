<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!-- Childhood Traits -->

  <BackstoryDef>
    <slot>Childhood</slot>
    <title>manufactorum child</title>
    <defName>SegCOTO_MechanicusManufactorumChild</defName>
    <titleShort>manufactorum child</titleShort>
    <baseDesc>[PAWN_nameDef] was pressed into service in a manufactorum while still a child due to a need for fine-detail work and a shortage of appropriate servitors. [PAWN_pronoun] has quite the manual dexterity to show for it, unlike the unfortunate ones who lost fingers or worse.</baseDesc>
    <spawnCategories>
      <li>SegCOTO_Mechanicus</li>
    </spawnCategories>
    <requiredWorkTags>
      <li>Crafting</li>
    </requiredWorkTags>
    <skillGains>
      <Plants>-2</Plants>
	  <Animals>-2</Animals>
      <Crafting>3</Crafting>
	  <Intellectual>-2</Intellectual>
    </skillGains>
    <workDisables>
      <li>None</li>
    </workDisables>
	<forcedTraits>
	  <Nimble />
	</forcedTraits>
    <disallowedTraits>
	  <Recluse MayRequire="Ludeon.RimWorld.Biotech"/>
    </disallowedTraits>
  </BackstoryDef>

<!-- Adulthood Traits -->

  <BackstoryDef>
    <slot>Adulthood</slot>
    <title>skitarii vanguard</title>
    <defName>SegCOTO_MechanicusSkitariiVanguard</defName>
    <titleShort>skitarius</titleShort>
    <baseDesc>[PAWN_nameDef] was a member of the vanguard in a forgeworld's skitarii clades, trained and honed for war in the name of the Omnissiah.</baseDesc>
    <spawnCategories>
      <li>SegCOTO_Skitarii</li>
    </spawnCategories>
    <requiredWorkTags>
      <li>Violent</li>
    </requiredWorkTags>
    <workDisables>
      <li>Artistic</li>
    </workDisables>
    <skillGains>
      <Shooting>3</Shooting>
      <Melee>3</Melee>
      <Social>-2</Social>
    </skillGains>
	<forcedTraits>
	  <Transhumanist />
	</forcedTraits>
    <disallowedTraits>
	  <Wimp />
    </disallowedTraits>
    <bodyTypeMale>Male</bodyTypeMale>
    <bodyTypeFemale>Female</bodyTypeFemale>
  </BackstoryDef>

  <BackstoryDef>
    <slot>Adulthood</slot>
    <title>skitarii ranger</title>
    <defName>SegCOTO_MechanicusSkitariiRanger</defName>
    <titleShort>skitarius</titleShort>
    <baseDesc>[PAWN_nameDef] was a member of the rangers in a forgeworld's skitarii clades, trained and honed for war in the name of the Omnissiah.</baseDesc>
    <spawnCategories>
      <li>SegCOTO_Skitarii</li>
    </spawnCategories>
    <requiredWorkTags>
      <li>Violent</li>
    </requiredWorkTags>
    <workDisables>
      <li>Artistic</li>
    </workDisables>
    <skillGains>
      <Shooting>5</Shooting>
      <Melee>1</Melee>
      <Social>-2</Social>
    </skillGains>
	<forcedTraits>
	  <Transhumanist />
	</forcedTraits>
    <disallowedTraits>
	  <Wimp />
    </disallowedTraits>
    <bodyTypeMale>Male</bodyTypeMale>
    <bodyTypeFemale>Female</bodyTypeFemale>
  </BackstoryDef>

  <BackstoryDef>
    <slot>Adulthood</slot>
    <title>magos</title>
    <defName>SegCOTO_MechanicusSkitariiRanger</defName>
    <titleShort>magos</titleShort>
    <baseDesc>[PAWN_nameDef] was inducted as a ranking Magos of the Adeptus Mechanicus, and [PAWN_pronoun] has achieved a broad mastery of many disciplines in the pursuit of the Quest for Knowledge.</baseDesc>
    <spawnCategories>
      <li>SegCOTO_Techpriest</li>
    </spawnCategories>
    <requiredWorkTags>
      <li>Crafting</li>
      <li>Intellectual</li>
      <li>Construction</li>
    </requiredWorkTags>
    <workDisables>
      <li>none</li>
    </workDisables>
    <skillGains>
      <Shooting>2</Shooting>
      <Melee>2</Melee>
	  <Construction>3</Construction>
	  <Mining>1</Mining>
	  <Crafting>4</Crafting>
	  <Medical>2</Medical>
	  <Intellectual>5</Intellectual>
    </skillGains>
	<forcedTraits>
	  <Transhumanist />
	</forcedTraits>
    <bodyTypeMale>Male</bodyTypeMale>
    <bodyTypeFemale>Female</bodyTypeFemale>
  </BackstoryDef>

</Defs>
