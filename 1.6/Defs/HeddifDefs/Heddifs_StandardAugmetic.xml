<ThingDef ParentName="BodyPartProstheticBase">
  <defName>Seg_COTO_StandardArm</defName>
  <label>standard augmetic arm</label>
  <description>An augmetic replacement arm which is quite a bit more capable than the baseline limb, but is somewhat roughly integrated with the remaining nerve endings and can sometimes cause minor stabbing or buzzing pains for the user.</description>
  <recipeMaker>
<researchPrerequisite>
 <li>Seg_COTO_TrueFlesh</li>
</researchPrerequisite>

    <recipeUsers Inherit="false">
        <li>Seg_COTO_CraftingTable</li>
