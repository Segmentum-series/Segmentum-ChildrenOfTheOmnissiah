<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- Stubber sounds -->
	<SoundDef>
		<defName>Seg_COTO_StubberSound</defName>  
		<context>MapOnly</context>  
		<maxSimultaneous>99</maxSimultaneous>  
		<subSounds>
			<li>
				<grains>
					<li Class="AudioGrain_Clip">
						<clipPath>Seg_COTO_Sound_Macrostubber</clipPath>
					</li>
				</grains>
			<volumeRange>30~40</volumeRange>
			<pitchRange>.8~1.4</pitchRange>
			</li>
		</subSounds>
	</SoundDef>

	<!-- Arc sounds -->
	<SoundDef>
		<defName>Seg_COTO_ArcSound</defName>  
		<context>MapOnly</context>  
		<maxSimultaneous>20</maxSimultaneous>  
		<subSounds>
			<li>
				<grains>
					<li Class="AudioGrain_Clip">
