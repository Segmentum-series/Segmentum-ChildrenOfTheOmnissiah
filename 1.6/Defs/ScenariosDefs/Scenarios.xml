<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ScenPartDef>
		<defName>Seg_ConfigurePawnsKindDefs</defName>
		<label>starting people</label>
		<scenPartClass>ScenPart_ConfigPage_ConfigureStartingPawns_KindDefs</scenPartClass>
		<selectionWeight>0</selectionWeight>
		<pageClass>Page_ConfigureStartingPawns</pageClass>
		<summaryPriority>500</summaryPriority>
		<category>Fixed</category>
	</ScenPartDef>

	<!-- Magos -->
	<PawnKindDef ParentName="BasePlayerPawnKind">
		<defName>Seg_COTO_ScenarioPawnKind_Magos</defName>
		<label>Magos</label>
		<defaultFactionType>Seg_COTO_PlayerMechanicus</defaultFactionType>
		<race>Human</race>
		<chemicalAddictionChance>0</chemicalAddictionChance>
		<apparelIgnoreSeasons>true</apparelIgnoreSeasons>
		<apparelTags Inherit="False">
			<!-- <li>?</li> -->
		</apparelTags>
		<apparelRequired Inherit="False">
			<li>Seg_COTO_Apparel_MagosHood</li>
			<li>Seg_COTO_Apparel_MagosCassock</li>
			<li>Seg_COTO_Apparel_MagosRobes</li>
			<li>Seg_COTO_Apparel_MagosBackpack</li>
		</apparelRequired>
		<ignoreIdeoApparelColors>true</ignoreIdeoApparelColors>
		<initialWillRange>0~0</initialWillRange>
		<apparelMoney>0~0</apparelMoney>
		<initialResistanceRange>13~21</initialResistanceRange>
		<humanPregnancyChance>0</humanPregnancyChance>
		<backstoryFiltersOverride>
			<li>
			<categoriesChildhood>
				<li>SegCOTO_Mechanicus</li>
			</categoriesChildhood>
			<categoriesAdulthood>
				<li>SegCOTO_Techpriest</li>
			</categoriesAdulthood>
			</li>
		</backstoryFiltersOverride>
	</PawnKindDef>

