		<race>Human</race>
		<chemicalAddictionChance>0.05</chemicalAddictionChance>
		<apparelIgnoreSeasons>true</apparelIgnoreSeasons>
		<apparelTags Inherit="False">
			<!-- <li>?</li> -->
		</apparelTags>
		<apparelRequired Inherit="False">
			<li>Seg_COTO_Apparel_SkitariiRangerHood</li>
			<li>Seg_COTO_Apparel_SkitariiFatigues</li>
			<li>Seg_COTO_Apparel_SkitariiWarPlate</li>
			<li>Seg_COTO_Apparel_SkitariiBackpack</li>
		</apparelRequired>
		<ignoreIdeoApparelColors>true</ignoreIdeoApparelColors>
		<initialWillRange>0~0</initialWillRange>
		<apparelMoney>0~0</apparelMoney>
		<initialResistanceRange>13~21</initialResistanceRange>
		<humanPregnancyChance>0</humanPregnancyChance>
		<backstoryFiltersOverride>
			<li>
			<categoriesChildhood>
				<li>SegCOTO_Mechanicus</li>
			</categoriesChildhood>
			<categoriesAdulthood>
				<li>SegCOTO_SkitariiRanger</li>
			</categoriesAdulthood>
			</li>
		</backstoryFiltersOverride>
	</PawnKindDef>

	<!-- Skitarii Vanguard -->
	<PawnKindDef ParentName="BasePlayerPawnKind">
		<defName>Seg_COTO_ScenarioPawnKind_SkitariiVanguard</defName>
		<label>Skitarii Vanguard</label>
		<defaultFactionType>Seg_COTO_PlayerMechanicus</defaultFactionType>
		<race>Human</race>
		<chemicalAddictionChance>0.05</chemicalAddictionChance>
		<apparelIgnoreSeasons>true</apparelIgnoreSeasons>
		<apparelTags Inherit="False">
			<!-- <li>?</li> -->
		</apparelTags>
		<apparelRequired Inherit="False">
			<li>Seg_COTO_Apparel_SkitariiVanguardHelmet</li>
			<li>Seg_COTO_Apparel_SkitariiFatigues</li>
			<li>Seg_COTO_Apparel_SkitariiWarPlate</li>
