<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <FleckDef ParentName="FleckBase">
        <defName>BlastPhosphorFlame</defName>
        <graphicData>
        <texPath>Things/Mote/BlastNepalmFlame</texPath>
        <shaderType>TransparentPostLight</shaderType>
        <renderInstanced>true</renderInstanced>
        </graphicData>
        <altitudeLayer>MoteOverhead</altitudeLayer>
        <solidTime>0</solidTime>
        <fadeOutTime>0.2</fadeOutTime>
    </FleckDef>
     <ThingDef ParentName="EtherealThingBase">
        <defName>PhosphorExplosion</defName>
        <label>phosphor explosion</label>
        <thingClass>Seg.PhosphorExplosion</thingClass>
        <tickerType>Normal</tickerType>
    </ThingDef>
    
  <HediffDef ParentName="BurnBase">
    <defName>PhosphorBurn</defName>
    <label>phosphor burn</label>
    <labelNoun>a phosphor burn</labelNoun>
    <description>A phosphor burn.</description>
    <comps>
      <li Class="HediffCompProperties_GetsPermanent">
        <permanentLabel>phosphor burn scar</permanentLabel>
      </li>
    </comps>
    <injuryProps>
      <destroyedLabel>Phosphor burned off</destroyedLabel>
      <destroyedOutLabel>Phosphor burned out</destroyedOutLabel>
    </injuryProps>
  </HediffDef>

    <DamageDef ParentName="Flame" Name="PhosphorFlame">
        <defName>PhosphorFlame</defName>
        <workerClass>Seg.DamageWorker_PhosphorFlame</workerClass>
        <label>phosphor flame</label>
        <deathMessage>{0} has phosphor burned to death.</deathMessage>
        <hediff>PhosphorBurn</hediff>
        <!-- <minDamageToFragment>40</minDamageToFragment>
        <defaultDamage>30</defaultDamage> -->
        <explosionCellFleck>BlastPhosphorFlame</explosionCellFleck>
        <!-- <explosionColorCenter>(1, 0.7, 0.7)</explosionColorCenter>
        <explosionColorEdge>(1, 1, 0.7)</explosionColorEdge> -->
    </DamageDef>

    <DamageDef ParentName="PhosphorFlame">
        <defName>PhosphorBurn</defName>
        <label>phosphor burn</label>
        <workerClass>DamageWorker_AddInjury</workerClass>
    </DamageDef>

    <DamageDef>
        <defName>PhosphorExtinguish</defName>
        <label>phosphor extinguish</label>
        <workerClass>Seg.DamageWorker_PhosphorExtinguish</workerClass>
        <canInterruptJobs>false</canInterruptJobs>
        <makesBlood>false</makesBlood>
        <defaultDamage>999999</defaultDamage>
        <hediff>CoveredInFirefoam</hediff>
        <explosionCellFleck>BlastExtinguisher</explosionCellFleck>
        <explosionColorEdge>(1, 1, 1, 0.05)</explosionColorEdge>
        <soundExplosion>Explosion_Stun</soundExplosion>
        <harmsHealth>false</harmsHealth>
        <combatLogRules>Damage_Extinguish</combatLogRules>
        <consideredHelpful>true</consideredHelpful>
    </DamageDef>

</Defs>