<Defs>

	
	<Vehicles.VehicleTurretDef ParentName="VehicleTurretBase">
		<defName>Seg_COTO_CognisHeavyStubber_Turret</defName>
		<label>Cognis heavy stubbers</label>
		<description>A twin-linked heavy stubber turret, designed to lay down a withering barrage of solid shot. It does so with high accuracy like all cognis weaponry, thanks to the awakened machine spirit housed within, and does not require crew to operate.</description>
		<turretType>Rotatable</turretType>
		<shotSound>GW_AM_HeavyBolter</shotSound>
		<projectile>Seg_COTO_StubShot</projectile>
		<reloadTimer>4.0</reloadTimer>
		<warmUpTimer>2.0</warmUpTimer>
		<magazineCapacity>2000</magazineCapacity>
		<chargePerAmmoCount>1</chargePerAmmoCount>
		<genericAmmo>true</genericAmmo>
		<empDisables>true</empDisables>

		<autoSnapTargeting>false</autoSnapTargeting>
		<rotationSpeed>5</rotationSpeed>
		<projectileOffset>1</projectileOffset>
		<projectileShifting>
			<li>-0.2</li>
			<li>0.2</li>
		</projectileShifting>
		<minRange>4</minRange>
		<maxRange>59.9</maxRange>
		<fireModes>
			<li>
				<shotsPerBurst>10</shotsPerBurst>
				<ticksBetweenShots>5</ticksBetweenShots>
				<ticksBetweenBursts>15</ticksBetweenBursts>
				<accuracyTouch>0.95</accuracyTouch>
				<accuracyShort>0.90</accuracyShort>
				<accuracyMedium>0.80</accuracyMedium>
				<accuracyLong>0.65</accuracyLong>
				<label>Single</label>
				<texPath>UI/Gizmos/FireRate_Single</texPath>
			</li>
			<li>
				<shotsPerBurst>50</shotsPerBurst>
				<ticksBetweenShots>5</ticksBetweenShots>
				<ticksBetweenBursts>20</ticksBetweenBursts>
				<accuracyTouch>0.55</accuracyTouch>
				<accuracyShort>0.68</accuracyShort>
				<accuracyMedium>0.63</accuracyMedium>
				<accuracyLong>0.45</accuracyLong>
				<label>Burst</label>
				<texPath>UI/Gizmos/FireRate_Burst</texPath>
			</li>
			<li>
				<shotsPerBurst>100</shotsPerBurst>
				<ticksBetweenShots>5</ticksBetweenShots>
				<ticksBetweenBursts>25</ticksBetweenBursts>
				<accuracyTouch>0.12</accuracyTouch>
				<accuracyShort>0.58</accuracyShort>
				<accuracyMedium>0.53</accuracyMedium>
				<accuracyLong>0.35</accuracyLong>
				<label>Auto</label>
				<texPath>UI/Gizmos/FireRate_Auto</texPath>
			</li>
		</fireModes>
		<gizmoIconTexPath>UI/Icons/Vehicles/Seg_COTO_ServoTurret_HeavyBolterIcon</gizmoIconTexPath>
		<graphicData>
			<texPath>Things/Vehicles/Skorpius/Turrets/Seg_COTO_Skorpius_CognisHeavyStubber</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
			<shaderType>CutoutComplexPattern</shaderType>
			<drawSize>(4.2, 4.2)</drawSize>
		</graphicData>
		<ammunition>
			<thingDefs>
				<li>Steel</li>
			</thingDefs>
		</ammunition>
	</Vehicles.VehicleTurretDef>


	
