	<ThingDef ParentName="BaseBullet">
		<defName>Seg_COTO_Skorpius_Missile</defName>
		<label>servitor guided missile</label>
		<thingClass>Projectile_Explosive</thingClass>
		<graphicData>
			<texPath>Things/Projectile/Seg_COTO_DisruptorRocket</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>TransparentPostLight</shaderType>
			<drawSize>(1,2)</drawSize>
		</graphicData>
		<projectile>
			<damageDef>Bomb</damageDef>
			<damageAmountBase>20</damageAmountBase>
			<speed>30</speed>
			<explosionRadius>6.9</explosionRadius>
			<soundHitThickRoof>Artillery_HitThickRoof</soundHitThickRoof>
			<soundExplode>MortarBomb_Explode</soundExplode>
			<soundImpactAnticipate>MortarRound_PreImpact</soundImpactAnticipate>
			<soundAmbient>MortarRound_Ambient</soundAmbient>
		</projectile>
		<comps>
				<li Class="taranchuk_homingprojectiles.CompProperties_HomingProjectile">
						<tickRate>1</tickRate> <!--this changes the rate this updates-->
						<lifetimeTicks>600</lifetimeTicks> <!--once this runs out, it disintegrates, used for things like missiles running out of fuel and disarming-->
						<delayTurnInTicks>3</delayTurnInTicks> <!--how soon after firing the projectile begins tracking-->
						<initialSpreadAngle>20</initialSpreadAngle> <!--the degrees allowed for it to spread when fired, this is for things like micromissile swarms that you would imagine converging on your target-->
						<tailMote>CracksShieldBreak</tailMote> <!--This gives it a trail of a specific mote-->
						<effectLifetime>30</effectLifetime> <!--the life of those motes-->
						<effectSize>1</effectSize> <!--the size of the motes-->
				</li>
			</comps>

	</ThingDef>
	
	<Vehicles.VehicleTurretDef ParentName="VehicleTurretBase">
		<defName>Seg_COTO_Skorpius_Missiles</defName>
		<label>Disruptor missile launcher</label>
		<description>The Skorpius can field a prow-mounted launcher for Disruptor missiles, which are servitor-guided explosives designed for anti-armour duties. The missiles can be fired singly or in a full barrage of 6 to ensure that the Omnissiah's enemies are overwhelmed.</description>
		<turretType>Static</turretType>
	<gizmoIconTexPath>Things/Projectile/Seg_COTO_DisruptorRocket</gizmoIconTexPath>

		<reloadTimer>30</reloadTimer>
		<warmUpTimer>2</warmUpTimer>

		<magazineCapacity>6</magazineCapacity>
		<chargePerAmmoCount>1</chargePerAmmoCount>
		 <genericAmmo>true</genericAmmo>
		 <projectile>Seg_COTO_Skorpius_Missile</projectile>

		<autoSnapTargeting>false</autoSnapTargeting>
		<rotationSpeed>0</rotationSpeed>
		<projectileOffset>2.1</projectileOffset>
		<projectileShifting>
			<li>-0.85</li>
			<li>0.9</li>
		</projectileShifting>
		<minRange>7</minRange>
		<maxRange>40.9</maxRange>


		<recoil>
			<distanceTotal>0.15</distanceTotal>
			<distancePerTick>0.05</distancePerTick>
			<speedMultiplierPostRecoil>0.1</speedMultiplierPostRecoil>
		</recoil>

		<fireModes>
			<li>
				<shotsPerBurst>6</shotsPerBurst>
				<ticksBetweenShots>5</ticksBetweenShots>
				<ticksBetweenBursts>30</ticksBetweenBursts>
