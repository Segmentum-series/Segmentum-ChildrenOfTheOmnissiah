<Defs>
 <ThingDef ParentName="BuildingFloorCoveringMediumBase">
    <defName>Seg_COTOSlab_Medium</defName>
    <label>Omnissian slab (medium)</label>
    <description>A stone bas relief slab of the sacred symbols of Mechanicus forgeworlds for decorating a floor.</description>
     <canGenerateDefaultDesignator>true</canGenerateDefaultDesignator>
     <dominantStyleCategory>Techist</dominantStyleCategory>
    <graphicData>
      <graphicClass>Graphic_Random</graphicClass>
      <texPath>Things/Building/SlabsForgeWorlds</texPath>
      <drawSize>(3,3)</drawSize>
    </graphicData>
     <thingClass>Seg.Building_Seg_COTOFloorCover</thingClass>
    <drawStyleCategory>Floors</drawStyleCategory>
    <designationCategory>Floors</designationCategory>
    <uiOrder>2000</uiOrder>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <stuffCategories>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>100</costStuffCount>
    <researchPrerequisites>
      <li>Stonecutting</li>
    </researchPrerequisites>
    <building>
      <isEdifice>false</isEdifice>
    </building>

  </ThingDef>
  
 <ThingDef ParentName="BuildingFloorCoveringMediumBase">
    <defName>Seg_COTOMetallicEmblem_Medium</defName>
    <label>Omnissian emblem (medium)</label>
    <description>A large embossed metallic tile of the sacred symbols of Mechanicus forgeworlds for decorating a floor.</description>
     <canGenerateDefaultDesignator>true</canGenerateDefaultDesignator>
     <dominantStyleCategory>Techist</dominantStyleCategory>
     <thingClass>Seg.Building_Seg_COTOFloorCover</thingClass>
    <graphicData>
      <graphicClass>Graphic_Random</graphicClass>
      <texPath>Things/Building/SlabsForgeWorlds</texPath>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <drawStyleCategory>Floors</drawStyleCategory>
    <designationCategory>Floors</designationCategory>
    <uiOrder>2001</uiOrder>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>100</costStuffCount>
    <researchPrerequisites>
      <li>Smithing</li>
    </researchPrerequisites>
    <building>
      <isEdifice>false</isEdifice>
    </building>

  </ThingDef>
  
</Defs>