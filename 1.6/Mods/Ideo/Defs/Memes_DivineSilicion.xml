<Defs>
<IssueDef>
    <defName>MachineWorship</defName>
    <label>Machine worship</label>
    <iconPath>UI/Ideoligions/Seg_COTO_Ideoligions_MachineF</iconPath>
</IssueDef>
<PreceptDef>
    <defName>Seg_COTO_DivineSilicion</defName>
    <issue>MachineWorship</issue>
    <label>divine silicon</label>
    <description>Colonists feel spiritually connected to machinery.</description>
    <impact>Medium</impact>

    <comps>
        <li Class="PreceptComp_SituationalThought">
            <thought>Seg_COTO_DivineSilicion</thought>
            <thoughtStageDescriptions>
                <li>No machinery</li>
                <li>One or two machines</li>
                <li>Three or four machines</li>
                <li>Five or more machines</li>
            </thoughtStageDescriptions>
        </li>
    </comps>
</PreceptDef>
<ThoughtDef>
    <defName>Seg_COTO_DivineSilicion</defName>
    <workerClass>Seg.ThoughtWorker_DivineSilicion</workerClass>

    <stages>
        <li>
            <label>no machinery</label>
            <description>No machinery nearby.</description>
            <baseMoodEffect>-4</baseMoodEffect>
        </li>
        <li>
            <label>one or two machines</label>
            <description>Only a little machinery nearby.</description>
            <baseMoodEffect>-1</baseMoodEffect>
        </li>
        <li>
            <label>three or four machines</label>
            <description>A decent amount of machinery nearby.</description>
            <baseMoodEffect>0</baseMoodEffect>
        </li>
        <li>
            <label>five or more machines</label>
            <description>Surrounded by machinery.</description>
            <baseMoodEffect>4</baseMoodEffect>
        </li>
    </stages>
</ThoughtDef>
</Defs>
