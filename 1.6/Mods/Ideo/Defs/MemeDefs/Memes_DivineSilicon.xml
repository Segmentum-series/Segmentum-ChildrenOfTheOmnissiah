<!--  precept defName need to be exactly this for performance reason when looking if ideo have the needed precept, if the defName need changed let me know  -->
<PreceptDef>
    <defName>RD_Precept_MachineryPreferred</defName>
    <issue>MachineWorship</issue>
    <label>Divine Silicon</label>
    <description>The presence of sacred machine spirits pleases the Machine God and his adherents, while their absence is an offence.</description>
    <impact>High</impact>
    <displayOrderInIssue>10</displayOrderInIssue>
    <selectionWeight>1</selectionWeight>
    <comps>
        <li Class="PreceptComp_SituationalThought">
            <thought>RD_Precept_MachineryPreferred</thought>
            <thoughtStageDescriptions>
                <li>No machinery nearby</li>
                <li>Far too little machinery nearby</li>
                <li>Too little machinery nearby</li>
                <li>Little machinery nearby</li>
                <li>Not enough machinery nearby</li>
                <li>Machine spirits present</li>
                <li>Machine spirits honoured</li>
                <li>Machine spirits thriving</li>
                <li>Honouring the Omnissiah</li>
            </thoughtStageDescriptions>
        </li>
    </comps>
    <modExtensions>
        <li Class="RimDarkRankPrecept.DefModExtension_PreceptMachinery">
        <!--  what count as machinery anyway?  -->
        <categories>
            <li>BuildingsProduction</li>
        </categories>
        <comps>
            <li>CompPowerTrader</li>
        </comps>
        </li>
    </modExtensions>
</PreceptDef>
<ThoughtDef>
    <defName>RD_Precept_MachineryPreferred</defName>
    <minExpectation>VeryLow</minExpectation>
    <workerClass>RimDarkRankPrecept.ThoughtWorker_Precept_Machinery</workerClass>
    <stages>
    <li>
        <label>No machinery</label>
        <description>There is no sacred machinery nearby. We languish without the touch of the machine spirits.</description>
        <baseMoodEffect>-10</baseMoodEffect>
    </li>
    <li>
        <label>Far too little machinery nearby</label>
        <description>There is only one piece of machinery with a living machine spirit nearby. This is far too few!</description>
        <baseMoodEffect>-6</baseMoodEffect>
    </li>
    <li>
        <label>Too little machinery nearby</label>
        <description>There is only a small amount of machinery nearby. We are not nurturing the machine spirits enough!</description>
        <baseMoodEffect>-4</baseMoodEffect>
    </li>
    <li>
        <label>Little machinery nearby</label>
        <description>We have some machinery nearby, but still not enough to provide honour to their spirits and the Omnissiah.</description>
        <baseMoodEffect>-3</baseMoodEffect>
    </li>
    <li>
        <label>Not enough machinery nearby</label>
        <description>While there are some spirit-animated machines nearby, there are too few to bring honour to the Omnissiah or our forge.</description>
        <baseMoodEffect>-1</baseMoodEffect>
    </li>
    <li>
        <label>Machine spirits present</label>
        <description>There is a decent amount of sacred machinery nearby, as there should be.</description>
        <baseMoodEffect>2</baseMoodEffect>
    </li>
    <li>
        <label>Machine spirits honoured</label>
        <description>We are making good use of sacred machinery and ensuring that we take care of its animating spirits. This honours them, and us.</description>
        <baseMoodEffect>3</baseMoodEffect>
    </li>
    <li>
        <label>Machine spirits thriving</label>
        <description>There are many sacred machines nearby, both used and cared for. It is comforting to be around the spirits in such numbers.</description>
        <baseMoodEffect>5</baseMoodEffect>
    </li>
    <li>
        <label>Honouring the Omnissiah</label>
        <description>It is comforting to be around the living machine spirits in such numbers, and to know that we honour the Omnissiah and his works to such an extent.</description>
        <baseMoodEffect>10</baseMoodEffect>
    </li>
    </stages>
    </ThoughtDef>
</Defs>
