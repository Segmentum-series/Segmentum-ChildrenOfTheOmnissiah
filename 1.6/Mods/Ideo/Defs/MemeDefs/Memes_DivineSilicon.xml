            <li>Seg_COTO_TechAcolytum</li>
            <li>Seg_COTO_AdeptProbatoris</li>
            <li>Seg_COTO_Enginseer</li>
            <li>Seg_COTO_Transmechanic</li>
            <li>Seg_COTO_Lexmechanic</li>
            <li>Seg_COTO_MagosBiologis</li>
