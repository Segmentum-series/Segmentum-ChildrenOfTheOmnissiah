<ThoughtDef>
    <defName>RD_RankDead_Troubling</defName>
    <durationDays>3</durationDays>
    <stackLimit>5</stackLimit>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
        <li>
            <label>Tech-priest died</label>
            <description>An ordained priest of the Cult Mechanicus has died! This is a blow for the forge.</description>
            <baseMoodEffect>-10</baseMoodEffect>
        </li>
    </stages>
</ThoughtDef>
<ThoughtDef>
    <defName>RD_KilledOurRank</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>30</durationDays>
    <stackLimit>5</stackLimit>
    <stackedEffectMultiplier>1</stackedEffectMultiplier>
    <stages>
    <li>
        <label>Killed one of our tech-priests</label>
        <description>This waste of organic material killed an ordained tech-priest of the Machine Cult!</description>
        <baseOpinionOffset>-25</baseOpinionOffset>
    </li>
    </stages>
</ThoughtDef>
