<Defs>
<WorkGiverDef><!-- Forge altar work giver-->
		<defName>WorkGiver_CraftingTableChemfuelHelixien</defName>
		<label>make things at forge altar</label>
		<giverClass>WorkGiver_DoBill</giverClass>
		<workType>Smithing</workType>
		<priorityInType>75</priorityInType>
		<verb>work at</verb>
		<gerund>working at</gerund>
		<requiredCapacities>
			<li>Manipulation</li>
		</requiredCapacities>
		<fixedBillGiverDefs>
			<li>Seg_COTO_CraftingTableHelixien</li>
		</fixedBillGiverDefs>
		<prioritizeSustains>true</prioritizeSustains>
	</WorkGiverDef>

<ThingDef ParentName="BenchBase">
		<defName>Seg_COTO_CraftingTableHelixien</defName>
		<label>mechanicus forge altar (gas powered)</label>
		<description>A workbench of the Cult Mechanicus, equipped with advanced tools and monitoring devices for the production and maintenance of advanced equipment. Uses helixien gas rather than generated Motive Force to power its workings.</description>
		<thingClass>Building_WorkTable</thingClass>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<pathCost>50</pathCost>
		<statBases>
			<MaxHitPoints>500</MaxHitPoints>
			<WorkToBuild>5000</WorkToBuild>
			<Flammability>1.0</Flammability>
		</statBases>
		<minifiedDef />
		<thingCategories Inherit="false" />
		<size>(6,2)</size>
		<costList>
			<Steel>200</Steel>
			<ComponentIndustrial>8</ComponentIndustrial>
			<ComponentSpacer>1</ComponentSpacer>
		</costList>
		<comps>
            <li Class="PipeSystem.CompProperties_ResourceTrader">
                <pipeNet>VHGE_HelixienNet</pipeNet>
                <consumptionPerTick>1</consumptionPerTick>
                <idleConsumptionPerTick>0</idleConsumptionPerTick>
            </li>
            <li Class="CompProperties_Flickable">
                <commandTexture>Things/Special/Fluid/VHGE_OverlayBase</commandTexture>
                <commandLabelKey>VHGE_CommandToggleGas_Label</commandLabelKey>
                <commandDescKey>VHGE_CommandToggleGas_Desc</commandDescKey>
            </li>
            <li Class="CompProperties_Glower">
                <glowRadius>6</glowRadius>
                <glowColor>(217,112,33,0)</glowColor>
            </li>
        </comps>
		<graphicData>
			<texPath>Things/Building/CraftingTableHelixien/Seg_COTO_CraftingTableHelixien</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(8,4)</drawSize>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<castEdgeShadows>true</castEdgeShadows>
		<staticSunShadowHeight>0.20</staticSunShadowHeight>
		<inspectorTabs>
		<li>ITab_Bills</li>
		</inspectorTabs>
		<building>
			<workTableRoomRole>Workshop</workTableRoomRole>
			<workTableNotInRoomRoleFactor>0.8</workTableNotInRoomRoleFactor>
			<spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
		</building>
		<fillPercent>0.5</fillPercent>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<hasInteractionCell>true</hasInteractionCell>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<designationCategory>Production</designationCategory>

		<constructionSkillPrerequisite>6</constructionSkillPrerequisite>
		<placeWorkers>
			<li>PlaceWorker_PreventInteractionSpotOverlap</li>
		</placeWorkers>
		<researchPrerequisites>
			<li>Seg_COTO_CultMechanicus</li>
		</researchPrerequisites>
		<modExtensions>
			<li Class="Core40k.DefModExtension_AllowColoringOfThings">
				<allowColoringOfApparel>true</allowColoringOfApparel>
				<allowColoringOfEquipment>true</allowColoringOfEquipment>
			</li>
			<li Class="VEF.Buildings.RecipeInheritanceExtension">
                <inheritRecipesFrom>
                    <li>Seg_COTO_CraftingTable</li>
                </inheritRecipesFrom>
            </li>
		</modExtensions>
	</ThingDef>
    </Defs>