<?xml version="1.0" encoding="utf-8"?>

<Defs>
	<BigAndSmall.ItemRestrictionDef>
		<defName>Seg_COTO_SicarianRestriction</defName><!-- Blocks non-Sicarians from using tagged apparels -->
		<restrictedTags>
			<li>Seg_COTO_SicarianTag</li>
		</restrictedTags>
	</BigAndSmall.ItemRestrictionDef>


	<!-- Sicarian battle armour -->
	<ThingDef ParentName="Seg_COTO_SkitariiBase">
		<defName>Seg_COTO_Apparel_SicarianBattleArmour</defName>
		<label>Sicarian battle armour</label>
		<description>Grievously wounded Skitarii are sometimes modified with particularly extensive augmetics and deployed in the Sicarian killclades. This armour is specially designed to work with the Sicarian augmetics while protecting the vestiges of organic flesh that remain.\n\n&lt;color=#40cbde&gt;Customizable in the styling station or Mechanicus forge altar&lt;/color&gt;.</description>
		<graphicData>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>BEWH_CutoutThreeColor</shaderType>
			<texPath>Things/Apparel/SicarianBattleArmour/Seg_COTO_SicarianBattleArmour</texPath>
		</graphicData>
		<statBases>
			<WorkToMake>60000</WorkToMake>
			<MaxHitPoints>550</MaxHitPoints>
			<Mass>2.2</Mass>
			<ArmorRating_Sharp>1.35</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.55</ArmorRating_Blunt>
			<ArmorRating_Heat>0.85</ArmorRating_Heat>
			<Insulation_Cold>5</Insulation_Cold>
			<Insulation_Heat>10</Insulation_Heat>
			<DecompressionResistance MayRequire="kentington.saveourship2">0.14</DecompressionResistance>
			<VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.14</VacuumResistance>
		</statBases>
		<equippedStatOffsets>
			<MentalBreakThreshold>-0.08</MentalBreakThreshold>
			<PainShockThreshold>0.3</PainShockThreshold>
			<MoveSpeed>0.2</MoveSpeed>
		</equippedStatOffsets>
		<recipeMaker>
			<researchPrerequisites Inherit="False">
				<li>Seg_COTO_SicarianKillclades</li>
			</researchPrerequisites>
		</recipeMaker>
		<costList>
			<Plasteel>40</Plasteel>
			<ComponentSpacer>2</ComponentSpacer>
			<Hyperweave>10</Hyperweave>
			<Seg_Ceramite>40</Seg_Ceramite>
		</costList>
		<apparel>
			<useWornGraphicMask>true</useWornGraphicMask>
			<tags>
				<li>Seg_COTO_SicarianBattleArmour</li>
				<li>Seg_COTO_SicarianTag</li>
			</tags>
			<countsAsClothingForNudity>true</countsAsClothingForNudity>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Shoulders</li>
				<li>Neck</li>
				<li>Arms</li>
				<li>Legs</li>
				<li>Hands</li>
				<li>Feet</li>
			</bodyPartGroups>
			<layers>
				<li>Shell</li>
				<li>Middle</li>
			</layers>
			<defaultOutfitTags>
				<li>Worker</li>
			</defaultOutfitTags>
			<wornGraphicPaths>
				<li>Things/Apparel/SicarianBattleArmour/Seg_COTO_SicarianBattleArmour</li>
			</wornGraphicPaths>
		</apparel>
		<comps>
			<li Class="Core40k.CompProperties_Decorative"> 
				<decorativeType>Body</decorativeType>
			</li>
			<li Class="Core40k.CompProperties_MultiColor" MayRequire="phonicmas.rimdark.frameworkcore">
				<defaultPrimaryColor>(146,12,18)</defaultPrimaryColor><!-- Mars red -->
				<defaultSecondaryColor>(166,166,166)</defaultSecondaryColor><!-- Grey -->
				<defaultTertiaryColor>(25,146,198)</defaultTertiaryColor><!-- Lenses blue -->
			</li>
		</comps>
		<modExtensions>
			<li Class="Core40k.DefModExtension_AvailableDrawerTabDefs">
				<tabDefs>
					<li>BEWH_ArmorColoring</li>
					<li>BEWH_ArmorDecoration</li>
				</tabDefs>
			</li>
			<li Class="taranchuk_apparelgraphics.ApparelExtension">
				<hideBody>False</hideBody>
				<femaleBody>Male</femaleBody>
			</li>
		</modExtensions>
	</ThingDef>


	<!-- Sicarian infiltrator helmet-->
	<ThingDef ParentName="Seg_COTO_SkitariiBase">
		<defName>Seg_COTO_Apparel_SicarianInfiltratorHelmet</defName>
		<label>Sicarian infiltrator helmet</label>
		<description>Sicarian infiltrators have distinctive circular dome shaped heads housing various sensors, optical aids, and auspex equipment to enable their skirmishing and infiltration attacks to a level far above standard skitarii. Where the Sicarian's cranium ends and the 'helmet' begins is often unclear.\n\n&lt;color=#40cbde&gt;Customizable in the styling station or Mechanicus forge altar&lt;/color&gt;.</description>

		<graphicData>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>BEWH_CutoutThreeColor</shaderType>
			<texPath>Things/Apparel/SicarianInfiltratorHelmet/Seg_COTO_SicarianInfiltratorHelmet</texPath>
		</graphicData>
		<uiIconPath>Things/Apparel/SicarianInfiltratorHelmet/Seg_COTO_SicarianInfiltratorHelmet</uiIconPath>

		<statBases>
			<WorkToMake>31000</WorkToMake>
			<MaxHitPoints>350</MaxHitPoints>
			<Mass>2.2</Mass>
			<ArmorRating_Sharp>1.1</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.85</ArmorRating_Blunt>
			<ArmorRating_Heat>.9</ArmorRating_Heat>
			<Insulation_Cold>5</Insulation_Cold>
			<Insulation_Heat>3</Insulation_Heat>
			<SocialImpact>-1</SocialImpact>
		</statBases>
		<equippedStatOffsets>
			<ToxicResistance>1.00</ToxicResistance>
			<ToxicEnvironmentResistance>1.0</ToxicEnvironmentResistance>
			<AimingDelayFactor>-0.50</AimingDelayFactor>
			<ShootingAccuracyPawn>0.30</ShootingAccuracyPawn>
			<SocialImpact>-1</SocialImpact>
		  <PainShockThreshold>0.5</PainShockThreshold>
		<SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">.50</SlaveSuppressionOffset>
		</equippedStatOffsets>
		<recipeMaker>
			<researchPrerequisites Inherit="False">
				<li>Seg_COTO_SicarianKillclades</li>
			</researchPrerequisites>
		</recipeMaker>
		<costList>
			<Plasteel>40</Plasteel>
			<ComponentSpacer>3</ComponentSpacer>
			<Seg_Ceramite>20</Seg_Ceramite>
		</costList>
		<apparel>
			<useWornGraphicMask>true</useWornGraphicMask>
			<tags>
				<li>Seg_COTO_SicarianInfiltratorHelmet</li>
				<li>Seg_COTO_SicarianTag</li>
			</tags>
			<countsAsClothingForNudity>true</countsAsClothingForNudity>
			<bodyPartGroups>
				<li>Neck</li>
				<li>UpperHead</li>
			</bodyPartGroups>
			<layers>
				<li>Overhead</li>
			</layers>
			<defaultOutfitTags>
				<li>Worker</li>
			</defaultOutfitTags>
			<wornGraphicPaths>
				<li>Things/Apparel/SicarianInfiltratorHelmet/Seg_COTO_SicarianInfiltratorHelmet</li>
			</wornGraphicPaths>
		</apparel>
		<comps>
			<li Class="Core40k.CompProperties_Decorative">
				<decorativeType>Head</decorativeType>
			</li>
			<li Class="Core40k.CompProperties_MultiColor" MayRequire="phonicmas.rimdark.frameworkcore">
				<defaultPrimaryColor>(146,12,18)</defaultPrimaryColor><!-- Mars red -->
				<defaultSecondaryColor>(234,130,56)</defaultSecondaryColor><!-- Adamantium -->
				<defaultTertiaryColor>(25,146,198)</defaultTertiaryColor><!-- Lenses blue -->
			</li>
		</comps>
		<modExtensions>
			<li Class="Core40k.DefModExtension_AvailableDrawerTabDefs">
				<tabDefs>
					<li>BEWH_ArmorColoring</li>
					<li>BEWH_ArmorDecoration</li>
				</tabDefs>
			</li>
		</modExtensions>
	</ThingDef>


	<!-- Sicarian ruststalker mask -->
	<ThingDef ParentName="Seg_COTO_SkitariiBase">
		<defName>Seg_COTO_Apparel_SicarianRuststalkerMask</defName>
		<label>Sicarian ruststalker mask</label>
		<description>Ruststalkers were originally a caste of Martian assassins charged with hunting down heretical exiles from the Machine Cult and the feral servitors that roam the Red Planet's wastes. Their distinctive masks give complete immunity to toxic environs like those of the cradle of the Machine Cult, as well as including optical enhancements to aid their combat abilities.\n\n&lt;color=#40cbde&gt;Customizable in the styling station or Mechanicus forge altar&lt;/color&gt;.</description>

		<graphicData>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>BEWH_CutoutThreeColor</shaderType>
			<texPath>Things/Apparel/SicarianRuststalkerMask/Seg_COTO_SicarianRuststalkerMask</texPath>
		</graphicData>
		<uiIconPath>Things/Apparel/SicarianRuststalkerMask/Seg_COTO_SicarianRuststalkerMask</uiIconPath>

		<statBases>
			<WorkToMake>31000</WorkToMake>
			<MaxHitPoints>350</MaxHitPoints>
			<Mass>2.2</Mass>
			<ArmorRating_Sharp>1.2</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.65</ArmorRating_Blunt>
			<ArmorRating_Heat>1</ArmorRating_Heat>
			<Insulation_Cold>5</Insulation_Cold>
			<Insulation_Heat>3</Insulation_Heat>
			<SocialImpact>0.20</SocialImpact>
		</statBases>
		<equippedStatOffsets>
			<ToxicResistance>1.00</ToxicResistance>
			<ToxicEnvironmentResistance>1.0</ToxicEnvironmentResistance>
			<AimingDelayFactor>-0.05</AimingDelayFactor>
			<MeleeDodgeChance>0.5</MeleeDodgeChance>
			<SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">.50</SlaveSuppressionOffset>
		</equippedStatOffsets>
		<recipeMaker>
			<researchPrerequisites Inherit="False">
				<li>Seg_COTO_SicarianKillclades</li>
			</researchPrerequisites>
		</recipeMaker>
		<costList>
			<Plasteel>30</Plasteel>
			<ComponentSpacer>2</ComponentSpacer>
			<Seg_Ceramite>50</Seg_Ceramite>
		</costList>
		<apparel>
			<useWornGraphicMask>true</useWornGraphicMask>
			<tags>
				<li>Seg_COTO_SicarianRuststalkerMask</li>
				<li>Seg_COTO_SicarianTag</li>
			</tags>
			<countsAsClothingForNudity>true</countsAsClothingForNudity>
			<bodyPartGroups>
				<li>Neck</li>
				<li>UpperHead</li>
			</bodyPartGroups>
			<layers>
				<li>Overhead</li>
			</layers>
			<defaultOutfitTags>
				<li>Worker</li>
			</defaultOutfitTags>
			<wornGraphicPaths>
				<li>Things/Apparel/SicarianRuststalkerMask/Seg_COTO_SicarianRuststalkerMask</li>
			</wornGraphicPaths>
		</apparel>
		<comps>
			<li Class="Core40k.CompProperties_Decorative">
				<decorativeType>Head</decorativeType>
			</li>
			<li Class="Core40k.CompProperties_MultiColor" MayRequire="phonicmas.rimdark.frameworkcore">
				<defaultPrimaryColor>(146,12,18)</defaultPrimaryColor><!-- Mars red -->
				<defaultSecondaryColor>(166,166,166)</defaultSecondaryColor><!-- Grey -->
				<defaultTertiaryColor>(80,94,104)</defaultTertiaryColor><!-- Bodysuit grey-blue -->
			</li>
		</comps>
		<modExtensions>
			<li Class="Core40k.DefModExtension_AvailableDrawerTabDefs">
				<tabDefs>
					<li>BEWH_ArmorColoring</li>
					<li>BEWH_ArmorDecoration</li>
				</tabDefs>
			</li>
		</modExtensions>
	</ThingDef>


	<!-- Sicarian backpack -->
	<ThingDef ParentName="Seg_COTO_BackpackBase">
		<defName>Seg_COTO_Apparel_SicarianBackpack</defName>
		<label>Sicarian powerpack</label>
		<description>Sicarian troops have little need to carry supplies or equipment like the baseline soldiers of the Militarum do, but their backpacks are still useful for the integral interface systems that boost the operation of their augmetic bodies.\n\n&lt;color=#40cbde&gt;Customizable in the styling station or Mechanicus forge altar&lt;/color&gt;.\n\n&lt;color=#bb8f04&gt;Powerpack or power source, refuelled with Uranium&lt;/color&gt;.</description>
		<graphicData>
			<texPath>Things/Apparel/SicarianBackpack/Seg_COTO_SicarianBackpack</texPath>
		</graphicData>
		<recipeMaker>
			<researchPrerequisite>Seg_COTO_SicarianKillclades</researchPrerequisite>
		</recipeMaker>
		<costList>
			<Plasteel>30</Plasteel>
			<ComponentIndustrial>5</ComponentIndustrial>
			<Cloth>20</Cloth>
			<Uranium>6</Uranium>
		</costList>
		<statBases>
			<WorkToMake>8000</WorkToMake>
			<MaxHitPoints>550</MaxHitPoints>
			<Mass>2.2</Mass>
			<ArmorRating_Sharp>0.60</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.30</ArmorRating_Blunt>
			<ArmorRating_Heat>0.01</ArmorRating_Heat> 
		</statBases>
		<equippedStatOffsets>
			<MoveSpeed>0.15</MoveSpeed>
			<CarryingCapacity>40</CarryingCapacity>
			<VEF_MassCarryCapacity>50</VEF_MassCarryCapacity>
			<SocialImpact>0.20</SocialImpact>
		</equippedStatOffsets>
		<apparel>
			<wornGraphicPath>Things/Apparel/SicarianBackpack/Seg_COTO_SicarianBackpack</wornGraphicPath>
			<tags>
				<li>Seg_COTO_SicarianTag</li>
			</tags>
			<defaultOutfitTags>
				<li>Soldier</li>
			</defaultOutfitTags>
		</apparel>
		<comps>
			<li Class="Core40k.CompProperties_MultiColor" MayRequire="phonicmas.rimdark.frameworkcore">
				<defaultPrimaryColor>(120,82,66)</defaultPrimaryColor>
				<defaultSecondaryColor>(255,255,255)</defaultSecondaryColor>
				<defaultTertiaryColor>(25,146,198)</defaultTertiaryColor>
				
			</li>
			<li Class="Core40k.CompProperties_Decorative">
				<decorativeType>Body</decorativeType>
			</li>
			<li Class="CompProperties_ApparelReloadable">
				<maxCharges>250</maxCharges>
				<ammoDef>Uranium</ammoDef>
				<ammoCountToRefill>10</ammoCountToRefill><!-- Refills the entire backpack's power source. Can be replaced with "<ammoCountPerCharge>0.0</ammoCountPerCharge>" -->
				<baseReloadTicks>40</baseReloadTicks>
				<soundReload>Standard_Reload</soundReload>
				<hotKey>Misc4</hotKey>
				<chargeNoun>powercell</chargeNoun>
				<displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
				<displayGizmoWhileDrafted>true</displayGizmoWhileDrafted>
			</li>
		</comps>
		<modExtensions>
			<li Class="Core40k.DefModExtension_AvailableDrawerTabDefs">
				<tabDefs>
					<li>BEWH_ArmorColoring</li>
				</tabDefs>
			</li>
		</modExtensions>
	</ThingDef>
	
</Defs>