<?xml version="1.0" encoding="utf-8" ?>

<Defs>
	<!-- Conversion -->
	<RecipeDef ParentName="BS_TransformSurgery">
		<defName>Seg_COTO_SicarianConversion</defName>
		<label>convert to sicarian</label>
		<description>Missing conversion description</description>
		<uiIconPath>UI/Icons/BS_CommandoHead</uiIconPath> <!-- REMEMBER TO CHANGE THE ICON LATER -->
		<jobString>Bestow Sicarian conversion</jobString>
		<uiIconPath>UI/Icons/BS_AndroidFaction</uiIconPath> <!-- REMEMBER TO CHANGE THE ICON LATER -->
		<skillRequirements>
			<Medicine>10</Medicine>
			<Crafting>10</Crafting>
		</skillRequirements>
		<developmentalStageFilter>Adult</developmentalStageFilter>
		<recipeUsers Inherit="False">
			<li>Human</li>
			<li MayRequire="Ludeon.RimWorld.Anomaly">CreepJoiner</li>
		</recipeUsers>
		<researchPrerequisite>
			<li>Seg_COTO_SicarianKillclades</li>
		</researchPrerequisite>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>ComponentSpacer</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>ComponentIndustrial</li>
					</thingDefs>
				</filter>
				<count>6</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>60</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Seg_Adamantium</li>
					</thingDefs>
				</filter>
				<count>10</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>ComponentSpacer</li>
				<li>ComponentIndustrial</li>
				<li>Steel</li>
				<li>Seg_Adamantium</li>
			</thingDefs>
		</fixedIngredientFilter>
		<addsHediff>Seg_COTO_Sicarian_Morph</addsHediff>
	</RecipeDef>
	
	<HediffDef>
		<defName>Seg_COTO_Sicarian_Morph</defName>
		<label>Sicarian Transformation</label>
		<description>blank</description>
		<hediffClass>HediffWithComps</hediffClass>
		<comps>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>
					<min>1000</min>
					<max>2000</max>
				</disappearsAfterTicks>
				<showRemainingTime>True</showRemainingTime>
			</li>
		</comps>
    <modExtensions>
    <li Class="BigAndSmall.PawnExtension">
      <morphSettings>
        <morphOverAge>3</morphOverAge>
      </morphSettings>
      <morphTargets>
        <li>
          <xenotype>Seg_COTO_Sicarian</xenotype>
          <removeHediffs>
            <li></li>
          </removeHediffs>
        </li>
      </morphTargets>
    </li>
  </modExtensions>
	</HediffDef>

</Defs>