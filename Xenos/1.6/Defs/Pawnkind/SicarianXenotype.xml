<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<GeneCategoryDef>
		<defName>SICARIAN</defName>
		<label>SICARIAN</label>
		<displayPriorityInXenotype>1001101</displayPriorityInXenotype>
	</GeneCategoryDef>

	<XenotypeDef>
		<defName>Seg_COTO_Sicarian</defName>
		<label>Sicarian</label>
		<description>The Adeptus Mechanicus sees every human as a resource, and even the most seriously wounded can be put to good use in the skitarii legions. Sicarians are living beings transformed into superbly efficient cybernetic killing machines, unsuited for anything besides holy warfare in the Omnissiah's name.</description>
		<descriptionShort>Forged by the Adeptus Mechanicus, Sicarians are not born but rebuilt into cybernetic instruments of the Omnissiah.</descriptionShort>
		<iconPath>UI/Icons/Xenotypes/Sicarian</iconPath>
		<inheritable>true</inheritable>
		<chanceToUseNameMaker>1</chanceToUseNameMaker>
		<genes>
			<li>Beard_NoBeardOnly</li>
			<li>Hair_BaldOnly</li>
			<li>Aggression_Aggressive</li>
			<li>Body_Standard</li>
			<li>Seg_COTO_Gene_Sicarian</li>
		</genes>
	</XenotypeDef>

	<GeneDef Name="SicarianGenes" Abstract="True">
		<displayCategory>SICARIAN</displayCategory>
	</GeneDef>

	<GeneDef ParentName="SicarianGenes">
		<defName>Seg_COTO_Gene_Sicarian</defName>
		<label>Sicarian adaptation</label>
		<description>Sicarians are living beings transformed into superbly efficient cybernetic killing machines, unsuited for anything besides holy warfare in the Omnissiah's name. Superfluous parts and brain tissue are removed, and the body is prepared for martial augmetics in their place.</description>
		<iconPath>UI/Icons/Seg_COTO_Icon_SicarianGene</iconPath>
		<displayOrderInCategory>1</displayOrderInCategory>
		<biostatMet>3</biostatMet>
		<biostatCpx>5</biostatCpx>
		<missingGeneRomanceChanceFactor>0.5</missingGeneRomanceChanceFactor>
		<disabledWorkTags>
			<li>Caring</li>
			<li>Animals</li>
			<li>ManualSkilled</li>
			<li>Artistic</li>
			<li>Intellectual</li>
			<li>Social</li>
		</disabledWorkTags>
		<forcedHeadTypes>
			<li>Male_Sicarian1</li>
			<li>Male_Sicarian2</li>
			<li>Male_Sicarian3</li>
			<li>Female_Sicarian1</li>
			<li>Female_Sicarian2</li>
			<li>Female_Sicarian3</li>
		</forcedHeadTypes>
		<renderNodeProperties Inherit="False">
			<li Class="BigAndSmall.PawnComplexRenderingProps">
				<useSkinShader>true</useSkinShader>
			</li>
		</renderNodeProperties>
		<painFactor>0.1</painFactor>
		<statOffsets>
			<PawnBeauty>-1.5</PawnBeauty>
			<WorkSpeedGlobal>-0.20</WorkSpeedGlobal>
			<CleaningSpeed>-0.20</CleaningSpeed>
			<MiningYield>-0.20</MiningYield>
		</statOffsets>
		<statFactors>
			<LifespanFactor>0.65</LifespanFactor>
			<CancerRate>1.5</CancerRate>
			<ImmunityGainSpeed>0.85</ImmunityGainSpeed>
			<Fertility>0</Fertility>
			<SM_BodySizeMultiplier>0.94</SM_BodySizeMultiplier>
		</statFactors>
		<makeImmuneTo>
			<li>SleepingSickness</li>
			<li>OrganDecay</li>
		</makeImmuneTo>
		<disablesNeeds>
			<li>Comfort</li>
			<li>Outdoors</li>
		</disablesNeeds>
		<skinIsHairColor>false</skinIsHairColor>
	<!-- Body definitions -->
		<exclusionTags>
			<li>Bodies</li>
			<li>Body</li>
			<li>Fur</li>
		</exclusionTags>
		<bodyType>Standard</bodyType>
		<tattoosVisible>false</tattoosVisible>
		<modExtensions>
			<li Class="BigAndSmall.PawnExtension">
				<headPaths>
					<Female>Things/Pawn/Humanlike/Heads/Female/Female_Average_Normal_Sicarian</Female>
						<Female>Things/Pawn/Humanlike/Heads/Female/Female_Average_Pointy_Sicarian</Female>
							<Female>Things/Pawn/Humanlike/Heads/Female/Female_Average_Wide_Sicarian</Female>
					<Male>Things/Pawn/Humanlike/Heads/Male/Male_Average_Normal_Sicarian</Male>
						<Male>Things/Pawn/Humanlike/Heads/Male/Male_Average_Pointy_Sicarian</Male>
							<Male>Things/Pawn/Humanlike/Heads/Male/Male_Average_Wide_Sicarian</Male>
				</headPaths>
				<bodyPaths>
					<Body_Female>Things/Pawn/Humanlike/Bodies/Naked_SicarianFemale</Body_Female>
					<Body_Male>Things/Pawn/Humanlike/Bodies/Naked_SicarianMale</Body_Male>
				</bodyPaths>
				<disableFacialAnimations>true</disableFacialAnimations>
				<headMaterial>
					<shader>CutoutComplex</shader>
					<overrideDesiccated>true</overrideDesiccated>
				</headMaterial>
				<apparelRestrictions>
					<tags>
						<acceptlist>
							<li>Seg_COTO_SicarianTag</li>
						</acceptlist>
					</tags>
				</apparelRestrictions>
			</li>
			<!-- <surgeryRecipes> How to later ban other conversions that may be done for the Magos
				<blacklist>
					<li>Banned other conversion</li>
				</blacklist>
			</surgeryRecipes> -->
		</modExtensions>
	</GeneDef>

</Defs>