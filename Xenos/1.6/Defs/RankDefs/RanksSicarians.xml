<Defs>
    <Seg.RankDef>
        <defName>Seg_COTO_SicarianRuststalker</defName>
        <label>Sicarian Ruststalker</label>
        <description>Ruststalkers are the elite of the Sicarian killclades, forming agile commando squads who excel at terrifying shock tactics. Some Militarum personnel nickname them 'shivs' for the shivering of their transonic weapons and the ferocity with which they gut their enemies. Grievously wounded skitarii are often converted into Sicarians so that they can still be of use to the Machine Cult.</description>
        <rankIconPath>UI/Ranks/Skitarii/Seg_COTO_RankSkitarii_SicarianRuststalker</rankIconPath>
        <rankTier>6</rankTier>
		<incompatibleRanks>
			<li>Seg_COTO_SicarianInfiltrator</li>
        </incompatibleRanks>
        <ImplantsRequired>8</ImplantsRequired>
        <requiredSkills>
            <Melee>10</Melee>
        </requiredSkills>
        <requiredGenesAll>
            <li>Seg_COTO_Gene_Sicarian</li>
        </requiredGenesAll>
         <givesPassions>
            <li>
            <skill>Melee</skill>
            <modType>AddOneLevel</modType> </li>
        </givesPassions>
        <givesAbilities>
            <li>Seg_COTO_RuststalkerShiveringFrenzy</li>
        </givesAbilities>

    

        <statOffsets>
            <BEWH_ArtificialPartsAffinityFactor>0.10</BEWH_ArtificialPartsAffinityFactor>
           <MeleeDodgeChance>.5</MeleeDodgeChance>
           <MoveSpeed>.1</MoveSpeed>
        </statOffsets>
         <statFactors>
            <PainShockThreshold>1.20</PainShockThreshold>
             <MeleeHitChance>1.20</MeleeHitChance>
        </statFactors>
    </Seg.RankDef>
    <Seg.RankDef>
        <defName>Seg_COTO_SicarianInfiltrator</defName>
        <label>Sicarian Infiltrator</label>
        <description>Sicarian Infiltrators are cybernetic scout troops who are so heavily modified as to barely deserve the label of 'human' anymore. They act as skirmishers and reconnaissance assault troops for the Skitarii Clades. Grievously wounded skitarii are often converted into Sicarians so that they can still be of use to the Machine Cult.</description>
        <rankIconPath>UI/Ranks/Skitarii/Seg_COTO_RankSkitarii_SicarianInfiltrator</rankIconPath>
        <rankTier>6</rankTier>
		<incompatibleRanks>
			<li>Seg_COTO_SicarianRuststalker</li>
        </incompatibleRanks>
        <ImplantsRequired>8</ImplantsRequired>
        <requiredSkills>
            <Shooting>5</Shooting>
            <Melee>8</Melee>
        </requiredSkills>
        <requiredGenesAll>
            <li>Seg_COTO_Gene_Sicarian</li>
        </requiredGenesAll>
         <givesPassions>
            <li>
            <skill>Melee</skill>
            <modType>AddOneLevel</modType> </li>
        </givesPassions>
        <givesVFEAbilities>
        <li>Seg_COTO_WaveburstAbility</li> 
        </givesVFEAbilities>

    

        <statOffsets>
            <BEWH_ArtificialPartsAffinityFactor>0.05</BEWH_ArtificialPartsAffinityFactor>
           <AimingDelayFactor>-0.02</AimingDelayFactor>
            <ComfyTemperatureMin>-10</ComfyTemperatureMin>
            <ComfyTemperatureMax>10</ComfyTemperatureMax>
        </statOffsets>
         <statFactors>
            <PainShockThreshold>1.40</PainShockThreshold>
            
        </statFactors>
    </Seg.RankDef>
    <Seg.RankDef>
        <defName>Seg_COTO_SicarianPrinceps</defName>
        <label>Sicarian Princeps</label>
        <description>Squads of Sicarians are led by a Princeps, equivalent to the Alphas of \nthe Vanguards and Rangers. Each Princeps is a terror on the battlefield \nand a holy expression of the Machine God's power.</description>
        <rankIconPath>UI/Ranks/Skitarii/Seg_COTO_RankSkitarii_SicarianPrinceps</rankIconPath>
        <rankTier>7</rankTier>
        <colonyLimitOfRank>(2, 0)</colonyLimitOfRank>
        <RequiredHediffs>
			<li>Seg_COTO_SkitariiDataUplink_Hediff</li>
			<li>Seg_COTO_SicarianChordclaws_Hediff</li>
		</RequiredHediffs>
        <requiredSkills>
            <Shooting>8</Shooting>
            <Melee>12</Melee>
        </requiredSkills>
        <requiredGenesAll>
            <li>Seg_COTO_Gene_Sicarian</li>
        </requiredGenesAll>
         <givesPassions>
            <li>
            <skill>Melee</skill>
            <modType>AddOneLevel</modType> </li>
        </givesPassions>


    

        <statOffsets>
            <BEWH_ArtificialPartsAffinityFactor>0.10</BEWH_ArtificialPartsAffinityFactor>
           <AimingDelayFactor>-0.02</AimingDelayFactor>
            <ComfyTemperatureMin>-10</ComfyTemperatureMin>
            <ComfyTemperatureMax>10</ComfyTemperatureMax>
            <MeleeDodgeChance>0.5</MeleeDodgeChance>
        </statOffsets>
         <statFactors>
            <PainShockThreshold>1.20</PainShockThreshold>
             <MeleeHitChance>1.10</MeleeHitChance>
        </statFactors>
    </Seg.RankDef>
