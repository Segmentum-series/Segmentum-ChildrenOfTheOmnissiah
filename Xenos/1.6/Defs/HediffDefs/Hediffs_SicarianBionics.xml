    <labelNoun>a chordclaw arm</labelNoun>
    <hediffClass>HediffWithComps</hediffClass>
    <description>An installed extra augmetic arm designed for the Sicarian corps. This battle claw is usually attached to the torso and has an array of transonic razors capable of annihilating flesh and bone. The arm is unsuitable for use on less extensively modified humans.</description>
    <spawnThingOnRemoved>Seg_COTO_SicarianChordclaws</spawnThingOnRemoved>
    <comps>
      <li Class="HediffCompProperties_VerbGiver">
        <tools>
          <li>
            <label>chordclaws</label>
            <capacities>
              <li>Cut</li>
            </capacities>
            <power>26</power>
            <armorPenetration>0.9</armorPenetration>
            <cooldownTime>2</cooldownTime>
            <soundMeleeHit>Seg_COTO_PoweredMeleeWeaponImpactSound</soundMeleeHit> <!--Needs sound-->
            <soundMeleeMiss>MeleeMiss_BionicPunch</soundMeleeMiss> <!--Needs sound-->
          </li>
        </tools>
      </li>
    </comps>
    <stages>
      <li>
        <painOffset>0.30</painOffset>
      </li>
    </stages>
  </HediffDef>

