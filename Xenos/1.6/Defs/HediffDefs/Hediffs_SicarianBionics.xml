  <!-- HediffDef -->
  <HediffDef ParentName="AddedBodyPartBase">
    <defName>Seg_COTO_SicarianArm_Hediff</defName>
    <label>Sicarian arm</label>
    <labelNoun>a Sicarian arm</labelNoun>
    <description>An installed augmetic replacement arm designed for the Sicarian corps of Infiltrators and Ruststalkers. These unnerving multiply-jointed arms are resilient and capable, and designed for the most intense battles in harsh conditions, but are unsuitable for use on less extensively modified humans.</description>
    <spawnThingOnRemoved>Seg_COTO_SicarianArm</spawnThingOnRemoved>
    <comps>
      <li Class="HediffCompProperties_VerbGiver">
        <tools>
          <li>
            <label>augmetic arm</label>
            <capacities>
              <li>Blunt</li>
            </capacities>
            <power>14</power>
            <cooldownTime>2</cooldownTime>
            <soundMeleeHit>MeleeHit_BionicPunch</soundMeleeHit>
            <soundMeleeMiss>MeleeMiss_BionicPunch</soundMeleeMiss>
          </li>
        </tools>
      </li>
    </comps>
    <addedPartProps>
      <solid>true</solid>
      <partEfficiency>1.20</partEfficiency>
      <betterThanNatural>true</betterThanNatural>
    </addedPartProps>
    <stages>
      <li>
        <statOffsets>
          <MeleeDodgeChance>.05</MeleeDodgeChance>
          <AimingDelayFactor>-0.01</AimingDelayFactor>
        </statOffsets>
        <statFactors>
          <MeleeHitChance>1.05</MeleeHitChance>
          <MeleeWeapon_CooldownMultiplier>0.95</MeleeWeapon_CooldownMultiplier>
          <ShootingAccuracyPawn>1.01</ShootingAccuracyPawn>
        </statFactors>
        <painOffset>0.20</painOffset>
      </li>
    </stages>
  </HediffDef>

  <!-- RecipeDef -->
  <RecipeDef ParentName="SurgeryInstallBodyPartArtificialBase">
    <defName>InstallSeg_COTO_SicarianArm</defName>
