  <ThingDef ParentName="BodyPartBionicBase">
    <defName>Seg_COTO_SicarianChordclaws</defName>
    <label>chordclaws</label>
    <recipeMaker>
      <researchPrerequisite>Seg_COTO_SicarianKillclades</researchPrerequisite>
      <recipeUsers Inherit="false">
        <li>Seg_COTO_AugmeticsTable</li>
      </recipeUsers>
    </recipeMaker>
    <description>An extra augmetic arm designed for the Sicarian corps. This battle claw is usually attached to the torso and has an array of transonic razors capable of annihilating flesh and bone. The arm is unsuitable for use on less extensively modified humans.</description>
    <statBases>
      <MarketValue>2000</MarketValue>
      <Mass>0.3</Mass>
    </statBases>
    <techHediffsTags Inherit="False">
      <li>Seg_COTO_SkitariiAugmetics</li>
    </techHediffsTags>

    <costList>
      <Plasteel>15</Plasteel>
      <Steel>40</Steel>
      <ComponentSpacer>2</ComponentSpacer>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <tradeTags Inherit="False">
      <li>Seg_COTO_SkitariiAugmetics</li>
    </tradeTags>
  </ThingDef>

  <!-- HediffDef -->
  <HediffDef ParentName="ImplantHediffBase">
